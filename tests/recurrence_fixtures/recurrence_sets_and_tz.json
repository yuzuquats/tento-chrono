    {
      "name": "composition_rule_only_unsync_dtstart_weekly_byday",
      "category": "composition",
      "start": "2025-01-14T10:00:00Z",
      "timezone": "UTC",
      "composition": "RULE_ONLY",
      "rules": ["RRULE:FREQ=WEEKLY;COUNT=3;BYDAY=FR"],
      "upTo": "2025-02-15",
      "expected": [
        "2025-01-17T10:00:00Z",
        "2025-01-24T10:00:00Z",
        "2025-01-31T10:00:00Z"
      ],
      "notes": "RULE_ONLY omits unsynchronized Tuesday DTSTART and counts 3 Fridays"
    },
