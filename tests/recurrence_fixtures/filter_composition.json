{
  "description": "Direct NaiveDate.Filter and NaiveDate.range composable filter pipeline fixtures validating filter order sensitivity, edge-rank bySetPos, calendar boundaries, and article/benchmark rules.",
  "cases": [
    {
      "name": "lunch_closure_before_bysetpos_falls_back",
      "category": "composition_order",
      "start": "2024-03-01",
      "step": {
        "unit": "months",
        "value": 1
      },
      "end": "2024-05-31",
      "filter": {
        "op": "bySetPos",
        "positions": [
          -1
        ],
        "inner": {
          "op": "compose",
          "filters": [
            {
              "op": "byWeekday",
              "weekdays": [
                "FRI"
              ]
            },
            {
              "op": "excludeDates",
              "dates": [
                "2024-03-29"
              ]
            }
          ]
        }
      },
      "expected": [
        "2024-03-22",
        "2024-04-26",
        "2024-05-31"
      ]
    },
    {
      "name": "lunch_closure_after_bysetpos_drops_march",
      "category": "composition_order",
      "start": "2024-03-01",
      "step": {
        "unit": "months",
        "value": 1
      },
      "end": "2024-05-31",
      "filter": {
        "op": "compose",
        "filters": [
          {
            "op": "bySetPos",
            "positions": [
              -1
            ],
            "inner": {
              "op": "byWeekday",
              "weekdays": [
                "FRI"
              ]
            }
          },
          {
            "op": "excludeDates",
            "dates": [
              "2024-03-29"
            ]
          }
        ]
      },
      "expected": [
        "2024-04-26",
        "2024-05-31"
      ],
      "notes": "Demonstrates order sensitivity: excluding after bySetPos drops March instead of falling back"
    },
