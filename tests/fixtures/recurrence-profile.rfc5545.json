{
  "type": "recurrence-profile",
  "name": "RFC 5545 default",
  "cases": [
    {
      "name": "unfold time selectors",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;\r\n\tBYHOUR=9,17;COUNT=2"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-01T17:00:00Z"
      ]
    },
    {
      "name": "exact UTC until",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;UNTIL=20260102T085959Z"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01T09:00:00Z"
      ]
    },
    {
      "name": "explicit dates extend past the end of 2099",
      "input": {
        "lines": [
          "DTSTART:20991230T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:21000102T090000Z,21000104T090000Z",
          "EXDATE:21000102T090000Z"
        ],
        "through": "2100-01-05"
      },
      "expected": [
        "2099-12-30T09:00:00Z",
        "2099-12-31T09:00:00Z",
        "2100-01-04T09:00:00Z"
      ]
    },
    {
      "name": "exdate only removes the matched instant",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;BYHOUR=9,17;COUNT=4",
          "EXDATE:20260101T090000Z"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01T17:00:00Z",
        "2026-01-02T09:00:00Z",
        "2026-01-02T17:00:00Z"
      ]
    },
    {
      "name": "inclusive civil-date until",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20260101",
          "RRULE:FREQ=DAILY;BYHOUR=9,17;UNTIL=20260103"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01",
        "2026-01-02",
        "2026-01-03"
      ]
    },
    {
      "name": "floating until",
      "input": {
        "lines": [
          "DTSTART:20260101T090000",
          "RRULE:FREQ=DAILY;UNTIL=20260102T090000"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01T09:00:00",
        "2026-01-02T09:00:00"
      ]
    },
    {
      "name": "time components preceding setpos",
      "input": {
        "lines": [
          "DTSTART:20260130T090000Z",
          "RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=9,17;BYSETPOS=-2;COUNT=4"
        ],
        "through": "2026-06-01"
      },
      "expected": [
        "2026-01-30T09:00:00Z",
        "2026-02-27T09:00:00Z",
        "2026-03-31T09:00:00Z",
        "2026-04-30T09:00:00Z"
      ]
    },
    {
      "name": "verified erratum 4271",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20260307T023000",
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "through": "2026-03-12"
      },
      "expected": [
        "2026-03-07T07:30:00Z",
        "2026-03-08T07:30:00Z",
        "2026-03-09T06:30:00Z"
      ]
    },
    {
      "name": "leap second fallback",
      "input": {
        "lines": [
          "DTSTART:20260101T090059Z",
          "RRULE:FREQ=HOURLY;BYSECOND=59,60;COUNT=3"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01T09:00:59Z",
        "2026-01-01T10:00:59Z",
        "2026-01-01T11:00:59Z"
      ]
    },
    {
      "name": "leap second fallback in a daily rule",
      "input": {
        "lines": [
          "DTSTART:20260101T090059Z",
          "RRULE:FREQ=DAILY;BYSECOND=60;COUNT=2"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01T09:00:59Z",
        "2026-01-02T09:00:59Z"
      ]
    },
    {
      "name": "case-insensitive recurrence",
      "input": {
        "lines": [
          "dtstart:20260101t090000z",
          "rrule:freq=daily;count=2"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "RFC example monthly first Friday",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:19970905T090000",
          "RRULE:FREQ=MONTHLY;BYDAY=1FR;COUNT=3"
        ],
        "through": "1997-12-01"
      },
      "expected": [
        "1997-09-05T13:00:00Z",
        "1997-10-03T13:00:00Z",
        "1997-11-07T14:00:00Z"
      ]
    },
    {
      "name": "RFC example invalid month days do not count",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20070115T090000",
          "RRULE:FREQ=MONTHLY;BYMONTHDAY=15,30;COUNT=5"
        ],
        "through": "2007-05-01"
      },
      "expected": [
        "2007-01-15T14:00:00Z",
        "2007-01-30T14:00:00Z",
        "2007-02-15T14:00:00Z",
        "2007-03-15T13:00:00Z",
        "2007-03-30T13:00:00Z"
      ]
    },
    {
      "name": "count with until",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2;UNTIL=20260101T090000Z"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "mutually exclusive"
      }
    },
    {
      "name": "duplicate count",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2;COUNT=3"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "Duplicate"
      }
    },
    {
      "name": "zero interval",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;INTERVAL=0"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "positive integer"
      }
    },
    {
      "name": "non-yearly week number",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=WEEKLY;BYWEEKNO=1;COUNT=2"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "requires YEARLY"
      }
    },
    {
      "name": "ordinal daily weekday",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;BYDAY=1MO;COUNT=2"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "Ordinal BYDAY"
      }
    },
    {
      "name": "weekly monthday",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=WEEKLY;BYMONTHDAY=1;COUNT=2"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "invalid for WEEKLY"
      }
    },
    {
      "name": "date-only until for timed start",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;UNTIL=20260103"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "DTSTART form"
      }
    },
    {
      "name": "out-of-range hour",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;BYHOUR=24"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "Invalid BYHOUR"
      }
    },
    {
      "name": "setpos without selector",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;BYSETPOS=1"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "requires another"
      }
    },
    {
      "name": "unknown extension",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=YEARLY;BYEASTER=0"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "Unknown RRULE"
      }
    },
    {
      "name": "untagged date DTSTART",
      "input": {
        "lines": [
          "DTSTART:20260101",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "DTSTART type"
      }
    },
    {
      "name": "zoned until must be UTC",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20260101T090000",
          "RRULE:FREQ=DAILY;UNTIL=20260103T090000"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "DTSTART form"
      }
    },
    {
      "name": "civil EXDATE does not remove a timed rule start in written mode",
      "input": {
        "rfcDateMode": "written",
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE;VALUE=DATE:20260101"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "multiple rules default validation",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RRULE:FREQ=WEEKLY;COUNT=2"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "at most one"
      }
    },
    {
      "name": "UTC exdate matches the earlier fold instant",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20261030T013000",
          "RRULE:FREQ=DAILY;COUNT=5",
          "EXDATE:20261101T053000Z"
        ],
        "through": "2026-11-06"
      },
      "expected": [
        "2026-10-30T05:30:00Z",
        "2026-10-31T05:30:00Z",
        "2026-11-02T06:30:00Z",
        "2026-11-03T06:30:00Z"
      ]
    },
    {
      "name": "hourly frequency expands the RFC minute selectors",
      "input": {
        "lines": [
          "DTSTART:20260105T091005Z",
          "RRULE:FREQ=HOURLY;BYMINUTE=10,40;COUNT=4"
        ],
        "through": "2026-01-05"
      },
      "expected": [
        "2026-01-05T09:10:05Z",
        "2026-01-05T09:40:05Z",
        "2026-01-05T10:10:05Z",
        "2026-01-05T10:40:05Z"
      ]
    },
    {
      "name": "UTC rdate keeps both fold instants",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20261031T001500",
          "RRULE:FREQ=DAILY;COUNT=3",
          "RDATE:20261101T053000Z,20261101T063000Z"
        ],
        "through": "2026-11-04"
      },
      "expected": [
        "2026-10-31T04:15:00Z",
        "2026-11-01T04:15:00Z",
        "2026-11-01T05:30:00Z",
        "2026-11-01T06:30:00Z",
        "2026-11-02T05:15:00Z"
      ]
    },
    {
      "name": "rdate with a foreign tzid resolves in that zone",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20260307T011500",
          "RRULE:FREQ=DAILY;COUNT=3",
          "RDATE;TZID=America/Chicago:20260308T023000"
        ],
        "through": "2026-03-10"
      },
      "expected": [
        "2026-03-07T06:15:00Z",
        "2026-03-08T06:15:00Z",
        "2026-03-08T08:30:00Z",
        "2026-03-09T05:15:00Z"
      ]
    },
    {
      "name": "rrule permits other parameters",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE;X-EXAMPLE=\"source:a;b\":FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-05T09:00:00Z",
        "2026-01-06T09:00:00Z"
      ]
    },
    {
      "name": "parameterized RRULE still validates its value",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE;X-EXAMPLE=1:FREQ=DAILY;INTERVAL=0"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "positive integer"
      }
    },
    {
      "name": "RFC rejects EXRULE",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXRULE:FREQ=DAILY;COUNT=1"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "EXRULE is not an RFC 5545 property"
      }
    },
    {
      "name": "positive period duration and explicit end",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;VALUE=PERIOD:20260108T090000Z/PT1H30M,20260109T090000Z/20260109T100000Z",
          "RDATE;VALUE=PERIOD;X-EXAMPLE=\"source:a;b\":20260110T090000Z/P1DT3H"
        ],
        "through": "2026-02-01"
      },
      "expected": [
        "2026-01-05T09:00:00Z",
        "2026-01-06T09:00:00Z",
        "2026-01-08T09:00:00Z",
        "2026-01-09T09:00:00Z",
        "2026-01-10T09:00:00Z"
      ]
    },
    {
      "name": "reject malformed period duration",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;VALUE=PERIOD:20260108T090000Z/PNONSENSE"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "Invalid RDATE period duration"
      }
    },
    {
      "name": "reject zero period duration",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;VALUE=PERIOD:20260108T090000Z/PT0H"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "Invalid RDATE period duration"
      }
    },
    {
      "name": "reject negative period duration",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;VALUE=PERIOD:20260108T090000Z/-PT1H"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "Invalid RDATE period duration"
      }
    },
    {
      "name": "reject mixed-weeks period duration",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;VALUE=PERIOD:20260108T090000Z/P1W2D"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "Invalid RDATE period duration"
      }
    },
    {
      "name": "reject reversed period endpoints",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;VALUE=PERIOD:20260108T090000Z/20260108T083000Z"
        ],
        "through": "2026-02-01"
      },
      "expected": {
        "error": "period end must follow"
      }
    },
    {
      "name": "quoted DTSTART extension parameter does not bind a timezone",
      "input": {
        "lines": [
          "DTSTART;X-NOTE=\"sent;uri:;TZID=Not/AZone\":20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-02"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "rrule-reject-incorrect-value-type",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE;VALUE=TEXT;X-NOTE=Example:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31"
      },
      "expected": {
        "error": "RRULE requires VALUE=RECUR"
      }
    },
    {
      "name": "rrule-accept-explicit-recur-value-type",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE;VALUE=RECUR;X-NOTE=Example:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "mixed-byday-expands-ordinary-and-ordinal-weekdays",
      "input": {
        "lines": [
          "DTSTART:20260105T090000Z",
          "RRULE:FREQ=MONTHLY;BYDAY=MO,1TU;COUNT=3"
        ],
        "through": "2027-12-31"
      },
      "expected": [
        "2026-01-05T09:00:00Z",
        "2026-01-06T09:00:00Z",
        "2026-01-12T09:00:00Z"
      ]
    },
    {
      "name": "verified-erratum-4271-daily-gap",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20260307T023000",
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "through": "2026-03-12"
      },
      "expected": [
        "2026-03-07T07:30:00Z",
        "2026-03-08T07:30:00Z",
        "2026-03-09T06:30:00Z"
      ]
    },
    {
      "name": "lord-howe-half-hour-gap-uses-offset-before-transition",
      "input": {
        "lines": [
          "DTSTART;TZID=Australia/Lord_Howe:20271001T021500",
          "RRULE:FREQ=DAILY;COUNT=6"
        ],
        "through": "2027-10-09"
      },
      "expected": [
        "2027-09-30T15:45:00Z",
        "2027-10-01T15:45:00Z",
        "2027-10-02T15:45:00Z",
        "2027-10-03T15:15:00Z",
        "2027-10-04T15:15:00Z",
        "2027-10-05T15:15:00Z"
      ]
    },
    {
      "name": "verified-erratum-4271-hourly-gap-collision",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20260308T013000",
          "RRULE:FREQ=HOURLY;COUNT=4"
        ],
        "through": "2026-03-12"
      },
      "expected": [
        "2026-03-08T06:30:00Z",
        "2026-03-08T07:30:00Z",
        "2026-03-08T08:30:00Z"
      ]
    },
    {
      "name": "reject-library-byweekday-alias",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=WEEKLY;BYWEEKDAY=MO;COUNT=2"
        ],
        "through": "2026-01-31"
      },
      "expected": {
        "error": "Unknown RRULE part: BYWEEKDAY"
      }
    },
    {
      "name": "external-milliseconds-preserved",
      "input": {
        "lines": [
          "RRULE:FREQ=SECONDLY;COUNT=3"
        ],
        "dtstart": {
          "dateTime": "2026-01-01T09:00:59.125Z"
        },
        "through": "2026-01-02"
      },
      "expected": [
        "2026-01-01T09:00:59.125Z",
        "2026-01-01T09:01:00.125Z",
        "2026-01-01T09:01:01.125Z"
      ]
    },
    {
      "name": "IANA Line Islands before the date-line change",
      "input": {
        "lines": [
          "DTSTART;TZID=Pacific/Kiritimati:19941228T093000",
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "through": "1994-12-31"
      },
      "expected": [
        "1994-12-28T19:30:00Z",
        "1994-12-29T19:30:00Z",
        "1994-12-30T19:30:00Z"
      ]
    },
    {
      "name": "IANA Casablanca before the 2026 Ramadan fold",
      "input": {
        "lines": [
          "DTSTART;TZID=Africa/Casablanca:20260213T023000",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-02-14"
      },
      "expected": [
        "2026-02-13T01:30:00Z",
        "2026-02-14T01:30:00Z"
      ]
    },
    {
      "name": "external DTSTART keeps the literal leap year zero",
      "input": {
        "lines": [
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "dtstart": {
          "dateTime": "0000-02-28T23:00:00Z"
        },
        "through": "0000-03-02"
      },
      "expected": [
        "0000-02-28T23:00:00Z",
        "0000-02-29T23:00:00Z",
        "0000-03-01T23:00:00Z"
      ]
    },
    {
      "name": "external DTSTART crosses into year 0100 in order",
      "input": {
        "lines": [
          "RRULE:FREQ=HOURLY;COUNT=3"
        ],
