{
  "type": "recurrence-profile",
  "name": "dateutil POSIX timezone spellings",
  "source": "python-dateutil 2.8.2 rrulestr and tz.gettz, TZ=UTC",
  "cases": [
    {
      "name": "embedded abbreviation semicolon retains the fixed offset",
      "input": {
        "profile": "dateutil",
        "through": "2026-01-08",
        "dtstart": {
          "dateTime": "2026-01-02T09:00:00",
          "timeZone": "X;ST3"
        },
        "lines": [
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-02T12:00:00Z",
        "2026-01-03T12:00:00Z",
        "2026-01-04T12:00:00Z",
        "2026-01-05T12:00:00Z"
      ]
    },
    {
      "name": "embedded abbreviation semicolon retains default daylight transitions",
      "input": {
        "profile": "dateutil",
        "through": "2026-04-10",
        "dtstart": {
          "dateTime": "2026-04-04T09:00:00",
          "timeZone": "X;ST3XDT"
        },
        "lines": [
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-04-02",
          "2026-04-03",
          "2026-04-04",
          "2026-04-05",
          "2026-04-07"
        ]
      },
      "expected": [
        "2026-04-04T12:00:00Z",
        "2026-04-05T11:00:00Z",
        "2026-04-06T11:00:00Z",
        "2026-04-07T11:00:00Z"
      ]
    },
    {
      "name": "a trailing semicolon alone can be the daylight abbreviation",
      "input": {
        "profile": "dateutil",
        "through": "2026-04-10",
        "dtstart": {
          "dateTime": "2026-04-04T09:00:00",
          "timeZone": "XST5;"
        },
        "lines": [
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-04-02",
          "2026-04-03",
          "2026-04-04",
          "2026-04-05",
          "2026-04-07"
        ]
      },
      "expected": [
        "2026-04-04T14:00:00Z",
        "2026-04-05T13:00:00Z",
        "2026-04-06T13:00:00Z",
        "2026-04-07T13:00:00Z"
      ]
    },
    {
      "name": "fixed timezone ignores an out-of-range transition month",
      "input": {
        "profile": "dateutil",
        "through": "2026-04-10",
        "lines": [
          "DTSTART;TZID=XST5,M13.2.0,M11.1.0:20260404T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-04-02",
          "2026-04-03",
          "2026-04-04",
          "2026-04-05",
          "2026-04-07"
        ]
      },
      "expected": [
        "2026-04-04T14:00:00Z",
        "2026-04-05T14:00:00Z",
        "2026-04-06T14:00:00Z",
        "2026-04-07T14:00:00Z"
      ]
    },
    {
      "name": "recurring timezone raises when its transition month is used",
      "input": {
        "profile": "dateutil",
        "through": "2026-04-10",
        "lines": [
          "DTSTART;TZID=XST5XDT,M13.2.0,M11.1.0:20260404T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ]
      },
      "expected": {
        "expansionError": "bad month number 13; must be 1-12"
      }
    },
    {
      "name": "default DST with terminal comma",
      "input": {
        "profile": "dateutil",
        "through": "2026-04-10",
        "lines": [
          "DTSTART;TZID=XST5XDT,:20260404T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-04-02",
          "2026-04-03",
          "2026-04-04",
          "2026-04-05",
          "2026-04-07"
        ]
      },
      "expected": [
        "2026-04-04T14:00:00Z",
        "2026-04-05T13:00:00Z",
        "2026-04-06T13:00:00Z",
        "2026-04-07T13:00:00Z"
      ]
    },
    {
      "name": "default DST with terminal semicolon",
      "input": {
        "profile": "dateutil",
        "through": "2026-10-30",
        "dtstart": {
          "dateTime": "2026-10-24T09:00:00",
          "timeZone": "XST5XDT;"
        },
        "lines": [
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-10-22",
          "2026-10-23",
          "2026-10-24",
          "2026-10-25",
          "2026-10-27"
        ]
      },
      "expected": [
        "2026-10-24T13:00:00Z",
        "2026-10-25T14:00:00Z",
        "2026-10-26T14:00:00Z",
        "2026-10-27T14:00:00Z"
      ]
    },
    {
      "name": "modern month zero uses the initial January month",
      "input": {
        "profile": "dateutil",
        "through": "2026-01-16",
        "lines": [
          "DTSTART;TZID=XST5XDT,M0.2.0,M11.1.0:20260110T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-01-08",
          "2026-01-09",
          "2026-01-10",
          "2026-01-11",
          "2026-01-13"
        ]
      },
      "expected": [
        "2026-01-10T14:00:00Z",
        "2026-01-11T13:00:00Z",
        "2026-01-12T13:00:00Z",
        "2026-01-13T13:00:00Z"
      ]
    },
    {
      "name": "numeric month zero uses January in leap years",
      "input": {
        "profile": "dateutil",
        "through": "2024-01-07",
        "lines": [
          "DTSTART;TZID=XST5XDT,0,0,0,0,11,1,0,0:20240101T000000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2023-12-30",
          "2023-12-31",
          "2024-01-01",
          "2024-01-02",
          "2024-01-04"
        ]
      },
      "expected": [
        "2024-01-01T04:00:00Z",
        "2024-01-02T04:00:00Z",
        "2024-01-03T04:00:00Z",
        "2024-01-04T04:00:00Z"
      ]
    },
    {
      "name": "explicit daylight offset permits a semicolon-delimited transition list",
      "input": {
        "profile": "dateutil",
        "through": "2026-03-13",
        "dtstart": {
          "dateTime": "2026-03-07T09:00:00",
          "timeZone": "XST5XDT4;M3.2.0;M11.1.0"
        },
        "lines": [
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-03-05",
          "2026-03-06",
          "2026-03-07",
          "2026-03-08",
          "2026-03-10"
        ]
      },
      "expected": [
        "2026-03-07T14:00:00Z",
        "2026-03-08T13:00:00Z",
        "2026-03-09T13:00:00Z",
        "2026-03-10T13:00:00Z"
      ]
    },
    {
      "name": "angle-delimited abbreviations retain their offsets",
      "input": {
        "profile": "dateutil",
        "through": "2026-04-10",
        "lines": [
          "DTSTART;TZID=<XST>5<XDT>:20260404T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-04-02",
          "2026-04-03",
          "2026-04-04",
          "2026-04-05",
          "2026-04-07"
        ]
      },
      "expected": [
        "2026-04-04T14:00:00Z",
        "2026-04-05T13:00:00Z",
        "2026-04-06T13:00:00Z",
        "2026-04-07T13:00:00Z"
      ]
    },
    {
      "name": "dots and underscores can appear in abbreviations",
      "input": {
        "profile": "dateutil",
        "through": "2026-10-30",
        "lines": [
          "DTSTART;TZID=X.S_T5X.D_T:20261024T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-10-22",
          "2026-10-23",
          "2026-10-24",
          "2026-10-25",
          "2026-10-27"
        ]
      },
      "expected": [
        "2026-10-24T13:00:00Z",
        "2026-10-25T14:00:00Z",
        "2026-10-26T14:00:00Z",
        "2026-10-27T14:00:00Z"
      ]
    },
    {
      "name": "fixed timezone ignores a trailing transition separator",
      "input": {
        "profile": "dateutil",
        "through": "2026-02-07",
        "lines": [
          "DTSTART;TZID=UTC+3,:20260201T010000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-01-30",
          "2026-01-31",
          "2026-02-01",
          "2026-02-02",
          "2026-02-04"
        ]
      },
      "expected": [
        "2026-01-31T22:00:00Z",
        "2026-02-01T22:00:00Z",
        "2026-02-02T22:00:00Z",
        "2026-02-03T22:00:00Z"
      ]
    },
    {
      "name": "fixed timezone can carry unused transition fields",
      "input": {
        "profile": "dateutil",
        "through": "2026-06-07",
        "lines": [
          "DTSTART;TZID=XST5,M3.2.0,M11.1.0:20260601T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2026-05-30",
          "2026-05-31",
          "2026-06-01",
          "2026-06-02",
          "2026-06-04"
        ]
      },
      "expected": [
        "2026-06-01T14:00:00Z",
        "2026-06-02T14:00:00Z",
        "2026-06-03T14:00:00Z",
        "2026-06-04T14:00:00Z"
      ]
    },
    {
      "name": "invalid transition month raises even with zero count",
      "input": {
        "profile": "dateutil",
        "through": "2026-04-10",
        "lines": [
          "DTSTART;TZID=XST5XDT,M13.2.0,M11.1.0:20260404T090000",
          "RRULE:FREQ=DAILY;COUNT=0"
        ]
      },
      "expected": {
        "expansionError": "bad month number 13; must be 1-12"
      }
    },
    {
      "name": "same-zone exclusion removes explicit date before validating month",
      "input": {
        "profile": "dateutil",
        "through": "2026-04-10",
        "lines": [
          "DTSTART;TZID=XST5XDT,M13.2.0,M11.1.0:20260404T090000",
          "RDATE;TZID=XST5XDT,M13.2.0,M11.1.0:20260404T090000",
          "EXDATE;TZID=XST5XDT,M13.2.0,M11.1.0:20260404T090000"
        ]
      },
      "expected": {
        "error": "unsupported RDATE parm: TZID=XST5XDT,M13.2.0,M11.1.0"
      }
    },
    {
      "name": "duplicate trailing separators leave the TZID unresolved",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART;TZID=XST5XDT,,:20260404T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "through": "2026-04-08",
        "checkpoints": [
          "2026-04-04",
          "2026-04-06"
        ]
      },
      "expected": [
        "2026-04-04T09:00:00",
        "2026-04-05T09:00:00",
        "2026-04-06T09:00:00",
        "2026-04-07T09:00:00"
      ]
    },
    {
      "name": "a malformed unused transition list still leaves a fixed TZID unresolved",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART;TZID=XST5,M3.2.0:20260404T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "through": "2026-04-08",
        "checkpoints": [
          "2026-04-04",
          "2026-04-06"
        ]
      },
      "expected": [
        "2026-04-04T09:00:00",
        "2026-04-05T09:00:00",
        "2026-04-06T09:00:00",
        "2026-04-07T09:00:00"
      ]
    },
    {
      "name": "offsets embedded in angle abbreviations leave the TZID unresolved",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART;TZID=<+03>-3:20260404T090000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "through": "2026-04-08",
        "checkpoints": [
          "2026-04-04",
          "2026-04-06"
        ]
      },
      "expected": [
        "2026-04-04T09:00:00",
        "2026-04-05T09:00:00",
        "2026-04-06T09:00:00",
        "2026-04-07T09:00:00"
      ]
    }
  ]
}
