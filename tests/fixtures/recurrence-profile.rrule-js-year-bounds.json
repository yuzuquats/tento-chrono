{
  "type": "recurrence-profile",
  "name": "rrule.js final calendar periods",
  "source": "rrule.js 2.8.1 RRuleSet, TZ=UTC",
  "cases": [
    {
      "name": "monthly retains both periods in 9999",
      "input": {
        "lines": [
          "RRULE:FREQ=MONTHLY;COUNT=5"
        ],
        "profile": "rrule-js",
        "dtstart": {
          "dateTime": "9999-11-30T23:59:59Z"
        },
        "through": "10000-12-31",
        "checkpoints": [
          "9999-12-30",
          "9999-12-31",
          "10000-01-01"
        ]
      },
      "expected": [
        "9999-11-30T23:59:59Z",
        "9999-12-30T23:59:59Z"
      ]
    },
    {
      "name": "implicit Saturday survives in the final Monday week",
      "input": {
        "lines": [
          "RRULE:FREQ=WEEKLY;COUNT=5"
        ],
        "profile": "rrule-js",
        "dtstart": {
          "dateTime": "9999-12-25T09:00:00Z"
        },
        "through": "10000-12-31",
        "checkpoints": [
          "9999-12-30",
          "9999-12-31",
          "10000-01-01"
        ]
      },
      "expected": [
        "9999-12-25T09:00:00Z",
        "10000-01-01T09:00:00Z"
      ]
    },
    {
      "name": "Saturday week start leaves the next period outside 9999",
      "input": {
        "lines": [
          "RRULE:FREQ=WEEKLY;WKST=SA;COUNT=5"
        ],
        "profile": "rrule-js",
        "dtstart": {
          "dateTime": "9999-12-25T09:00:00Z"
        },
        "through": "10000-12-31",
        "checkpoints": [
          "9999-12-30",
          "9999-12-31",
          "10000-01-01"
        ]
      },
      "expected": [
        "9999-12-25T09:00:00Z"
      ]
    },
    {
      "name": "Sunday week start leaves the next period outside 9999",
      "input": {
        "lines": [
          "RRULE:FREQ=WEEKLY;WKST=SU;BYMONTH=1,12;COUNT=5"
        ],
        "profile": "rrule-js",
        "dtstart": {
          "dateTime": "9999-12-26T12:01:00Z"
        },
        "through": "10000-12-31",
        "checkpoints": [
          "9999-12-30",
          "9999-12-31",
          "10000-01-01"
        ]
      },
      "expected": [
        "9999-12-26T12:01:00Z"
      ]
    },
