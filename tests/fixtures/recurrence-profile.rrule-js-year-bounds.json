      "name": "last week includes Monday and both spillover days",
      "input": {
        "lines": [
          "RRULE:FREQ=WEEKLY;BYDAY=MO,SA,SU;COUNT=5"
        ],
        "profile": "rrule-js",
        "dtstart": {
          "dateTime": "9999-12-27T23:59:59Z"
