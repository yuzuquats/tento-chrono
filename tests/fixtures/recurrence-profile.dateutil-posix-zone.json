      "input": {
        "profile": "dateutil",
        "through": "2026-04-08",
        "checkpoints": [
          "2026-04-02",
          "2026-04-03",
          "2026-04-04",
          "2026-04-05",
          "2026-04-06",
          "2026-04-07"
        ],
        "lines": [
          "DTSTART;TZID=XST5XDT:20260404T023000",
          "RRULE:FREQ=DAILY;COUNT=6"
        ]
      },
      "expected": [
        "2026-04-04T07:30:00Z",
        "2026-04-05T06:30:00Z",
        "2026-04-06T06:30:00Z",
        "2026-04-07T06:30:00Z",
        "2026-04-08T06:30:00Z"
      ]
    },
