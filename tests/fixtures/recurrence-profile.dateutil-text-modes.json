{
  "type": "recurrence-profile",
  "name": "Dateutil explicit text modes",
  "source": "python-dateutil 2.8.2 rrulestr with forceset, and unfold for continuation lines",
  "cases": [
    {
      "name": "packed properties/unfold=False",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260102T090000 RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-10",
        "checkpoints": [
          "2026-01-02",
          "2026-01-03",
          "2026-01-04"
        ],
        "dateutilUnfold": false
      },
      "expected": [
        "2026-01-02T09:00:00",
        "2026-01-03T09:00:00"
      ]
    },
    {
      "name": "packed properties/unfold=True",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260102T090000 RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-10",
        "checkpoints": [
          "2026-01-02",
          "2026-01-03",
          "2026-01-04"
        ],
        "dateutilUnfold": true
      },
      "expected": {
        "error": "Unknown string format: 20260102T090000 RRULE:FREQ=DAILY;COUNT=2"
      }
    },
    {
      "name": "frequency diagnostic preserves the final tab/unfold=False",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260102T090000 RRULE:FREQ=DAILY;COUNT=2\t"
        ],
        "through": "2026-01-10",
        "checkpoints": [
          "2026-01-02",
          "2026-01-03",
          "2026-01-04"
        ],
        "dateutilUnfold": false
      },
      "expected": [
        "2026-01-02T09:00:00",
        "2026-01-03T09:00:00"
      ]
    },
    {
      "name": "frequency diagnostic preserves the final tab/unfold=True",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260102T090000 RRULE:FREQ=DAILY;COUNT=2\t"
        ],
        "through": "2026-01-10",
        "checkpoints": [
          "2026-01-02",
          "2026-01-03",
          "2026-01-04"
        ],
        "dateutilUnfold": true
      },
      "expected": {
        "error": "Unknown string format: 20260102T090000 RRULE:FREQ=DAILY;COUNT=2\t"
      }
    },
    {
      "name": "space-only continuation/unfold=False",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260102T090000",
          "RRULE:FREQ=DAILY;COUNT=2\u001f",
          " "
        ],
        "through": "2026-01-10",
        "checkpoints": [
          "2026-01-02",
          "2026-01-03",
          "2026-01-04"
        ],
        "dateutilUnfold": false
      },
      "expected": [
        "2026-01-02T09:00:00",
        "2026-01-03T09:00:00"
      ]
    },
    {
      "name": "space-only continuation/unfold=True",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260102T090000",
          "RRULE:FREQ=DAILY;COUNT=2\u001f",
          " "
        ],
        "through": "2026-01-10",
        "checkpoints": [
          "2026-01-02",
          "2026-01-03",
          "2026-01-04"
        ],
        "dateutilUnfold": true
      },
      "expected": {
        "error": "invalid 'COUNT': 2\u001f"
      }
    },
