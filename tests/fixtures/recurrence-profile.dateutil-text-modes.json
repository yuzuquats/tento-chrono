    {
      "name": "RFC folding remains available with the dateutil option present",
      "input": {
        "profile": "rfc5545",
        "dateutilUnfold": false,
        "through": "2026-01-04",
        "checkpoints": [
          "2026-01-02"
        ],
        "lines": [
          "DTSTART:20260102T09",
          " 0000Z",
          "RRULE:FREQ=DAILY;COUNT=2"
