        "lines": [
          "DTSTART:20260101T090000",
          "RRULE:FREQ=DAILY;COUNT=٢"
        ],
        "profile": "dateutil",
        "through": "2026-06-01",
        "checkpoints": [
          "2026-01-01",
          "2026-02-15"
        ]
      },
      "expected": [
        "2026-01-01T09:00:00",
        "2026-01-02T09:00:00"
      ]
    },
