{
  "type": "recurrence-profile",
  "name": "RFC 5545 overlapping calendar timezone transitions",
  "source": "RFC 5545 section 3.3.5 with explicit UTC offset segments",
  "cases": [
    {
      "name": "overlapping-zone-transitions-hourly-fold",
      "input": {
        "lines": [
          "DTSTART;TZID=X-Calendar:20260102T013000",
          "RRULE:FREQ=HOURLY;COUNT=4"
        ],
        "rfcTimeZones": {
          "X-Calendar": {
            "transitions": [
              {
                "before": "2026-01-02T04:00:00+04:00",
                "after": "2026-01-02T02:00:00+02:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              },
              {
                "before": "2026-01-02T02:30:00+02:00",
                "after": "2026-01-02T03:30:00+03:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              }
            ]
          }
        },
        "through": "2026-01-03",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02"
        ]
      },
      "expected": [
        "2026-01-01T21:30:00Z",
        "2026-01-01T22:30:00Z",
        "2026-01-01T23:30:00Z",
        "2026-01-02T01:30:00Z"
      ]
    },
    {
      "name": "overlapping-zone-transitions-rdate-and-exdate",
      "input": {
        "lines": [
          "DTSTART:20260101T213000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;TZID=X-Calendar:20260102T033000,20260102T035900",
          "EXDATE:20260101T235900Z"
        ],
        "rfcTimeZones": {
          "X-Calendar": {
            "transitions": [
              {
                "before": "2026-01-02T04:00:00+04:00",
                "after": "2026-01-02T02:00:00+02:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              },
              {
                "before": "2026-01-02T02:30:00+02:00",
                "after": "2026-01-02T03:30:00+03:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              }
            ]
          }
        },
        "through": "2026-01-03",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02"
        ]
      },
      "expected": [
        "2026-01-01T21:30:00Z",
        "2026-01-01T23:30:00Z",
        "2026-01-02T21:30:00Z"
      ]
    },
    {
      "name": "overlapping-zone-transitions-utc-until",
      "input": {
        "lines": [
          "DTSTART;TZID=X-Calendar:20260102T013000",
          "RRULE:FREQ=HOURLY;UNTIL=20260101T233000Z"
        ],
        "rfcTimeZones": {
          "X-Calendar": {
            "transitions": [
              {
                "before": "2026-01-02T04:00:00+04:00",
                "after": "2026-01-02T02:00:00+02:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              },
              {
                "before": "2026-01-02T02:30:00+02:00",
                "after": "2026-01-02T03:30:00+03:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              }
            ]
          }
        },
        "through": "2026-01-03",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02"
        ]
      },
      "expected": [
        "2026-01-01T21:30:00Z",
        "2026-01-01T22:30:00Z",
        "2026-01-01T23:30:00Z"
      ]
    }
  ]
}
