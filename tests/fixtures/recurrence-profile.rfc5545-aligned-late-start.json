        "lines": [
          "DTSTART:20200131T173000Z",
          "RRULE:FREQ=MONTHLY;INTERVAL=1;COUNT=4;BYDAY=1MO,-1FR;BYMONTHDAY=1,2,3,8,9,15,-1,-2,-7;BYHOUR=9,17;BYSETPOS=1,1,-1"
        ],
        "through": "2024-12-31",
        "checkpoints": [
          "2020-01-31",
          "2020-02-03",
          "2020-02-28",
          "2020-03-02",
          "2020-12-31",
          "2021-12-31",
          "2022-12-31",
          "2023-12-31"
        ]
      },
      "expected": [
        "2020-01-31T17:30:00Z",
        "2020-02-03T09:30:00Z",
        "2020-02-28T17:30:00Z",
        "2020-03-02T09:30:00Z"
      ]
    },
