{
  "type": "recurrence-profile",
  "name": "Dateutil folded numeric calendar fields",
  "source": "python-dateutil 2.8.2 rrulestr with forceset and unfold",
  "cases": [
    {
      "name": "ambiguous fields use month first",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:2\r\n  1 2026 09:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-02-01T09:30:00",
        "2026-02-02T09:30:00"
      ]
    },
    {
      "name": "a first field above twelve uses day first",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:13\r\n  2 2026 09:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-02-13T09:30:00",
        "2026-02-14T09:30:00"
      ]
    },
    {
      "name": "a leading year fixes the order of tab-separated fields",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:2026\r\n \t2\t13\t09:30Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-02-13T09:30:00Z",
        "2026-02-14T09:30:00Z"
      ]
    },
    {
      "name": "a short year uses the pinned parser year",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:1\r\n  2 26 09:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-01-02T09:30:00",
        "2026-01-03T09:30:00"
      ]
    },
    {
      "name": "a numeric year and month inherit and clip the day",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:2026\r\n  2 09:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-02-28T09:30:00",
        "2026-03-01T09:30:00"
      ]
    },
    {
      "name": "a weekday after numeric fields can advance the inherited day",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:2026\r\n  2 FRI 09:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-03-06T09:30:00",
        "2026-03-07T09:30:00"
      ]
    },
    {
      "name": "numeric RDATE retains its annotated offset",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:2026\r\n  1 2 09:30 +0200 (CET)"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T07:30:00Z",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "numeric EXDATE omits the matching UTC occurrence",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE:1\r\n  2 2026 09:00 UTC"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-01-01T09:00:00Z"
      ]
    },
    {
      "name": "numeric UNTIL retains its inclusive UTC cutoff",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;UNTIL=2026\r\n  1 2 09:00Z"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": {
        "error": "unknown parameter name"
      }
    },
    {
      "name": "invalid day in a numeric date keeps the original diagnostic",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:31\r\n  2 2026 09:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": {
        "error": "day is out of range for month: 31 2 2026 09:30"
      }
    }
  ]
}
