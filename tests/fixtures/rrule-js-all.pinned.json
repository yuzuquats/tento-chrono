{
  "type": "rrule-js-all",
  "name": "rrule.js 2.8.1 all traversal",
  "source": "Pinned rrule.js 2.8.1 RRule and RRuleSet all()",
  "cases": [
    {
      "name": "standalone preserves written BYHOUR traversal",
      "input": {
        "lines": [
          "DTSTART:20260101T000000Z",
          "RRULE:FREQ=DAILY;BYHOUR=18,9;COUNT=4"
        ],
        "rruleJsForceSet": false,
        "rruleJsHostTimeZone": "UTC"
      },
      "expected": [
        "2026-01-01T18:00:00Z",
        "2026-01-01T09:00:00Z",
        "2026-01-02T18:00:00Z",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "forced set sorts the same values",
      "input": {
        "lines": [
          "DTSTART:20260101T000000Z",
          "RRULE:FREQ=DAILY;BYHOUR=18,9;COUNT=4"
        ],
        "rruleJsForceSet": true,
        "rruleJsHostTimeZone": "UTC"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-01T18:00:00Z",
        "2026-01-02T09:00:00Z",
        "2026-01-02T18:00:00Z"
      ]
    },
    {
      "name": "standalone retains repeated selector outputs",
      "input": {
        "lines": [
          "DTSTART:20260101T000000Z",
          "RRULE:FREQ=DAILY;BYHOUR=18,18,9;COUNT=5"
        ],
        "rruleJsForceSet": false,
        "rruleJsHostTimeZone": "UTC"
      },
      "expected": [
        "2026-01-01T18:00:00Z",
        "2026-01-01T18:00:00Z",
        "2026-01-01T09:00:00Z",
        "2026-01-02T18:00:00Z",
        "2026-01-02T18:00:00Z"
      ]
    },
    {
      "name": "set consumes repetitions before deduplication",
      "input": {
        "lines": [
          "DTSTART:20260101T000000Z",
          "RRULE:FREQ=DAILY;BYHOUR=18,18,9;COUNT=5"
        ],
        "rruleJsForceSet": true,
        "rruleJsHostTimeZone": "UTC"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-01T18:00:00Z",
        "2026-01-02T18:00:00Z"
      ]
    },
    {
      "name": "ordinary set merges RDATE and EXDATE",
