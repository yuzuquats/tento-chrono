{
  "type": "recurrence-profile",
  "name": "rrule.js signed millisecond remainder",
  "source": "rrule.js 2.8.1 RRuleSet with external Date, TZ=UTC",
  "cases": [
    {
      "name": "yearly midnight start skips a pre-start carry",
      "input": {
        "lines": [
          "RRULE:FREQ=YEARLY;COUNT=6"
        ],
        "profile": "rrule-js",
        "dtstart": {
          "dateTime": "1969-12-29T00:00:00.125Z"
        },
        "through": "2110-01-01",
        "checkpoints": [
          "1969-12-29",
          "1969-12-31",
          "1970-01-01"
        ]
      },
      "expected": [
        "1970-12-28T23:59:59.125Z",
        "1971-12-28T23:59:59.125Z",
        "1972-12-28T23:59:59.125Z",
        "1973-12-28T23:59:59.125Z",
        "1974-12-28T23:59:59.125Z",
        "1975-12-28T23:59:59.125Z"
      ]
    },
