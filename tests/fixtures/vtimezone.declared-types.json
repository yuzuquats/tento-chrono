    {
      "name": "RFC 5646 syntax accepts extlangs variants extensions private use and grandfathered tags",
      "input": {
        "lines": [
          "BEGIN:VTIMEZONE",
          "TZID:X-Metadata",
          "LAST-MODIFIED:20260101T000000Z",
          "TZURL:https://example.org/tz.ics",
          "BEGIN:STANDARD",
          "DTSTART:20260101T000000",
          "TZOFFSETFROM:+0100",
          "TZOFFSETTO:+0200",
          "TZNAME;LANGUAGE=zh-cmn-Hans-CN:NEW",
          "TZNAME;LANGUAGE=es-419:NEW",
          "TZNAME;LANGUAGE=de-DE-1901:NEW",
          "TZNAME;LANGUAGE=en-Latn-US-u-nu-latn-x-local:NEW",
          "TZNAME;LANGUAGE=x-u:NEW",
          "TZNAME;LANGUAGE=i-klingon:NEW",
          "TZNAME;LANGUAGE=sgn-CH-DE:NEW",
          "TZNAME;LANGUAGE=en-a-abc-z-xyz:NEW",
          "END:STANDARD",
