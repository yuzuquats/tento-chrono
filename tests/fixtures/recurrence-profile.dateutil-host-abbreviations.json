{
  "type": "recurrence-profile",
  "name": "Dateutil process-local timezone abbreviations",
  "source": "python-dateutil 2.8.2 on glibc 2.39 and IANA tzdata 2026e",
  "cases": [
    {
      "name": "a host date has awareness without DTSTART",
      "input": {
        "profile": "dateutil",
        "lines": [
          "RDATE:20260307T013000EST",
          "EXDATE:20260307T013000Z"
        ],
        "through": "2026-03-11",
        "dateutilHost": {
          "names": [
            "EST",
            "EDT"
          ],
          "standardOffsetSeconds": -18000,
          "daylightOffsetSeconds": -14400,
          "localTime": [
            [
              1762063200,
              false,
              -18000
            ],
            [
              1772953200,
              true,
              -14400
            ]
          ]
        },
        "checkpoints": [
          "2026-03-07"
        ]
      },
      "expected": [
        "2026-03-07T06:30:00Z"
      ]
    },
    {
      "name": "host EST follows local daylight time and can repeat UTC starts across a gap",
      "input": {
