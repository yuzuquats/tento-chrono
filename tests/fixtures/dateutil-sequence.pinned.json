{
  "type": "dateutil-sequence",
  "name": "dateutil 2.8.2 sequence operations",
  "source": "python-dateutil 2.8.2 uncached rrulestr, __getitem__, count",
  "cases": [
    {
      "name": "RRuleTest.testGetItem",
      "input": {
        "lines": [
          "DTSTART:19970902T090000",
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "queries": [
          {
            "method": "at",
            "index": 0
          }
        ]
      },
      "expected": [
        "1997-09-02T09:00:00"
      ]
    },
    {
      "name": "RRuleTest.testGetItemNeg",
      "input": {
        "lines": [
          "DTSTART:19970902T090000",
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "queries": [
          {
            "method": "at",
            "index": -1
          }
        ]
      },
      "expected": [
        "1997-09-04T09:00:00"
      ]
    },
    {
      "name": "RRuleTest.testGetItemSlice",
      "input": {
        "lines": [
          "DTSTART:19970902T090000",
          "RRULE:FREQ=DAILY"
        ],
        "queries": [
          {
            "method": "slice",
            "start": 1,
            "stop": 2
          }
        ]
      },
      "expected": [
        [
          "1997-09-03T09:00:00"
        ]
      ]
    },
    {
      "name": "RRuleTest.testGetItemSliceEmpty",
      "input": {
        "lines": [
          "DTSTART:19970902T090000",
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "queries": [
          {
            "method": "slice"
          }
        ]
      },
      "expected": [
        [
          "1997-09-02T09:00:00",
          "1997-09-03T09:00:00",
          "1997-09-04T09:00:00"
        ]
      ]
    },
    {
      "name": "RRuleTest.testGetItemSliceStep",
      "input": {
        "lines": [
