        "profile": "dateutil",
        "lines": [
          "DTSTART:20260301T000000",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:MAR-2026T09T09:15T45S,MAR-2026T09T09:15T45.000001S",
          "EXDATE:MAR-2026T09T09:15T45S"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "checkpoints": [
          "2026-03-01",
          "2026-03-09"
        ],
        "through": "2026-03-09",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
