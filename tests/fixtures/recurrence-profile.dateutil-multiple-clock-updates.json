{
  "type": "recurrence-profile",
  "name": "Dateutil multiple clock updates",
  "source": "python-dateutil 2.8.2 rrulestr with a frozen process-local date",
  "cases": [
    {
      "name": "a third clock can replace seconds after a colon reset",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260331T012026.5T09:15T45S",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-31",
          "2026-04-01"
        ]
      },
      "expected": [
        "2026-03-31T09:15:45",
        "2026-04-01T09:15:45"
      ]
    },
    {
      "name": "an attached T merges with the preceding hour unit",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260331T012026.5T9HT45S",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": []
      },
      "expected": {
        "error": "Unknown string format: 20260331T012026.5T9HT45S"
      }
    },
    {
      "name": "a complete calendar cannot accept a further numeric field",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260331T012026.5T09:15T09",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": []
      },
      "expected": {
        "error": "Unknown string format: 20260331T012026.5T09:15T09"
      }
    },
    {
      "name": "a trailing numeric field fills the day after two clocks",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:MAR-2026T012026T09:15T09",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-09",
          "2026-03-10"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-03-09T09:15:00",
        "2026-03-10T09:15:00"
      ]
    },
    {
      "name": "a short hour can follow a number that filled the last calendar field",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:MAR-2026T09T09T08:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-09",
          "2026-03-10"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-03-09T08:30:00",
        "2026-03-10T08:30:00"
      ]
    },
    {
      "name": "two numbers can fill the day and short year before the first hour",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:MAR.T09T09T08:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2010-12-31",
        "checkpoints": [
          "2009-03-09",
          "2009-03-10"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2009-03-09T08:30:00",
        "2009-03-10T08:30:00"
      ]
    },
    {
      "name": "five clock groups are applied in written order",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260331T012026.5T09:15T08:30.25T000030T23:15",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-31",
          "2026-04-01"
        ]
      },
      "expected": [
        "2026-03-31T23:15:00",
        "2026-04-01T23:15:00"
      ]
    },
    {
      "name": "a fourth clock and offset can follow a fractional clock after a month",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:MAR012026.500001T09:15T091530.25+0000T09:15+0300",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-31",
          "2026-04-01"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-03-31T06:15:00Z",
        "2026-04-01T06:15:00Z"
      ]
    },
    {
      "name": "two colon resets can retain the original microseconds",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260331T000000",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:20260331T012026.5T09:15T08:30"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-31",
          "2026-04-01"
        ]
      },
      "expected": [
        "2026-03-31T00:00:00",
        "2026-03-31T08:30:00.500",
        "2026-04-01T00:00:00"
      ]
    },
    {
      "name": "the cutoff uses the third clock and previously set offset",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260331T033000Z",
          "RRULE:FREQ=DAILY;UNTIL=20260331T012026.5T091530-0330T45S"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-31"
        ]
      },
      "expected": [
        "2026-03-31T03:30:00Z"
      ]
    },
    {
      "name": "an exclusion distinguishes microseconds after multiple updates",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260331T000000",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:20260331T012026.5T09:15T15M,20260331T012026.500001T09:15T15M",
          "EXDATE:20260331T012026.5T09:15T15M"
        ],
        "checkpoints": [
          "2026-03-31"
        ],
        "through": "2026-03-31"
      },
      "expected": [
        "2026-03-31T00:00:00",
        "2026-03-31T09:15:00.500"
      ]
    },
    {
      "name": "a third clock carries the second clock's offset",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260331T000000Z",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:20260331T012026+0300T09:15-0330T45S",
          "EXDATE:20260331T124546Z"
        ],
        "checkpoints": [
          "2026-03-31"
        ],
        "through": "2026-03-31"
      },
      "expected": [
        "2026-03-31T00:00:00Z",
        "2026-03-31T12:45:45Z"
      ]
    },
    {
      "name": "a late clock update moves the explicit date into the next UTC window",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260331T000000Z",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:20260331T012026+0300T09:15T121530-0430T23:15"
        ],
        "checkpoints": [
          "2026-03-31",
          "2026-04-01"
        ],
        "through": "2026-04-01"
      },
      "expected": [
        "2026-03-31T00:00:00Z",
        "2026-04-01T03:45:00Z"
      ]
    },
    {
      "name": "a UTC alias persists and allows deduplication across explicit forms",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260331T000000Z",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:20260331T012026.5Z.T09:15T08:30+0530,20260331T083000.5Z"
        ],
        "checkpoints": [
          "2026-03-31"
        ],
        "through": "2026-03-31"
      },
      "expected": [
        "2026-03-31T00:00:00Z",
        "2026-03-31T08:30:00.500Z"
      ]
    },
    {
      "name": "an exclusion matches a clock after earlier numeric calendar fields",
