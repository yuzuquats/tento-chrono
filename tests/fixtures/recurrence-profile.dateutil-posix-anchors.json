{
  "type": "recurrence-profile",
  "name": "dateutil POSIX transition anchors",
  "source": "python-dateutil 2.8.2 rrulestr and tz.gettz, TZ=UTC",
  "cases": [
    {
      "name": "fall clock subtraction precedes weekday selection",
      "input": {
        "profile": "dateutil",
        "through": "2026-11-07",
        "lines": [
          "DTSTART;TZID=XST25XDT5,M3.2.0,M11.1.0:20261101T030000",
          "RRULE:FREQ=DAILY;COUNT=1"
        ],
        "checkpoints": [
          "2026-10-30",
          "2026-10-31",
          "2026-11-01",
          "2026-11-02",
          "2026-11-04"
        ]
      },
      "expected": [
        "2026-11-01T08:00:00Z"
      ]
    },
    {
      "name": "fall transition reaches invalid standard time after the repeated window",
      "input": {
        "profile": "dateutil",
        "through": "2026-11-08",
        "lines": [
          "DTSTART;TZID=XST25XDT5,M3.2.0,M11.1.0:20261102T030000",
          "RRULE:FREQ=DAILY;COUNT=1"
        ]
      },
      "expected": {
        "expansionError": "offset must be a timedelta strictly between -timedelta(hours=24) and timedelta(hours=24)."
      }
    },
    {
      "name": "same-zone exclusion removes a candidate after the clock-adjusted transition",
      "input": {
        "profile": "dateutil",
        "through": "2026-11-08",
        "lines": [
          "DTSTART;TZID=XST25XDT5,M3.2.0,M11.1.0:20261102T030000",
          "RRULE:FREQ=DAILY;COUNT=1",
          "EXDATE;TZID=XST25XDT5,M3.2.0,M11.1.0:20261102T030000"
        ],
        "checkpoints": [
          "2026-10-31",
          "2026-11-01",
          "2026-11-02",
          "2026-11-03",
          "2026-11-05"
        ]
      },
      "expected": []
    },
    {
      "name": "a transition clock above 24 hours shifts the weekday anchor",
      "input": {
        "profile": "dateutil",
        "through": "2026-03-11",
        "lines": [
          "DTSTART;TZID=XST5XDT,M3.1.0/99,M11.1.0/26:20260305T020000",
          "RRULE:FREQ=DAILY;COUNT=6"
        ],
        "checkpoints": [
          "2026-03-03",
          "2026-03-04",
          "2026-03-05",
          "2026-03-06",
          "2026-03-08"
        ]
      },
      "expected": [
        "2026-03-05T07:00:00Z",
        "2026-03-06T07:00:00Z",
        "2026-03-07T07:00:00Z",
        "2026-03-08T07:00:00Z",
        "2026-03-09T06:00:00Z",
        "2026-03-10T06:00:00Z"
      ]
    },
    {
      "name": "midnight end applies standard clock shift before ranking weekday",
      "input": {
        "profile": "dateutil",
        "through": "2026-11-07",
        "lines": [
          "DTSTART;TZID=XST5XDT,M3.1.0,M11.1.0/0:20261101T003000",
          "RRULE:FREQ=HOURLY;COUNT=4"
        ],
        "checkpoints": [
          "2026-10-30",
          "2026-10-31",
          "2026-11-01",
          "2026-11-02",
          "2026-11-04"
        ]
      },
      "expected": [
        "2026-11-01T04:30:00Z",
        "2026-11-01T05:30:00Z",
        "2026-11-01T06:30:00Z",
        "2026-11-01T07:30:00Z"
      ]
    },
    {
      "name": "legacy signed weekday ranks use the clock-adjusted date",
      "input": {
        "profile": "dateutil",
        "through": "2026-10-31",
        "lines": [
          "DTSTART;TZID=XST5XDT,3,1,0,93600,10,-1,0,90000:20261025T000000",
          "RRULE:FREQ=DAILY;COUNT=5"
        ],
        "checkpoints": [
          "2026-10-23",
          "2026-10-24",
          "2026-10-25",
          "2026-10-26",
          "2026-10-28"
        ]
      },
      "expected": [
        "2026-10-25T04:00:00Z",
        "2026-10-26T04:00:00Z",
        "2026-10-27T04:00:00Z",
        "2026-10-28T04:00:00Z",
        "2026-10-29T04:00:00Z"
      ]
    },
    {
      "name": "zero week anchors at month end and large weekday wraps",
      "input": {
        "profile": "dateutil",
        "through": "2024-04-04",
        "lines": [
          "DTSTART;TZID=XST5XDT,M3.0.7,M10.6.7:20240329T020000",
          "RRULE:FREQ=DAILY;COUNT=6"
        ],
        "checkpoints": [
          "2024-03-27",
          "2024-03-28",
          "2024-03-29",
          "2024-03-30",
          "2024-04-01"
        ]
      },
      "expected": [
        "2024-03-29T07:00:00Z",
        "2024-03-30T07:00:00Z",
        "2024-03-31T06:00:00Z",
        "2024-04-01T06:00:00Z",
        "2024-04-02T06:00:00Z",
        "2024-04-03T06:00:00Z"
      ]
    },
    {
      "name": "positive week six can land in the following month",
      "input": {
        "profile": "dateutil",
        "through": "2026-11-11",
        "lines": [
          "DTSTART;TZID=XST5XDT,M3.0.7,M10.6.7:20261105T020000",
          "RRULE:FREQ=DAILY;COUNT=6"
        ],
        "checkpoints": [
          "2026-11-03",
          "2026-11-04",
          "2026-11-05",
          "2026-11-06",
          "2026-11-08"
        ]
      },
      "expected": [
        "2026-11-05T06:00:00Z",
        "2026-11-06T06:00:00Z",
        "2026-11-07T06:00:00Z",
        "2026-11-08T07:00:00Z",
        "2026-11-09T07:00:00Z",
        "2026-11-10T07:00:00Z"
      ]
    },
    {
      "name": "Julian zero and 366 clamp before choosing seasonal offset",
      "input": {
        "profile": "dateutil",
        "through": "2025-01-05",
        "lines": [
          "DTSTART;TZID=XST5XDT,J0,J366:20241230T000000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "checkpoints": [
          "2024-12-28",
          "2024-12-29",
          "2024-12-30",
          "2024-12-31",
          "2025-01-02"
        ]
      },
      "expected": [
        "2024-12-30T04:00:00Z",
        "2024-12-31T04:00:00Z",
        "2025-01-01T05:00:00Z",
        "2025-01-02T04:00:00Z"
      ]
    }
  ]
}
