        "2026-01-03T21:00:00Z",
        "2026-01-04T15:30:00Z",
        "2026-01-05T00:30:00"
      ]
    },
    {
      "name": "matching typed inputs deduplicate across COUNT and date lists",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20260101",
          "RRULE:FREQ=DAILY;COUNT=3",
          "RDATE;VALUE=DATE:20260101,20260102",
