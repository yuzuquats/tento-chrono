        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01",
        "2026-01-02T00:00:00",
        "2026-01-02T00:00:00Z"
      ]
    },
