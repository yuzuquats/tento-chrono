        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01T09:00:00",
        "2026-01-02T14:00:00Z",
        "2026-01-02T14:00:00"
      ]
    },
    {
      "name": "mixed EXDATE values each compare in their own form",
