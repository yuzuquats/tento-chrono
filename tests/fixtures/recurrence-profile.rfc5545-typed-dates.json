{
  "type": "recurrence-profile",
  "rfcDateMode": "written",
  "name": "RFC 5545 typed recurrence dates",
  "source": "RFC 5545 \u00a7\u00a73.3.4\u20135 and 3.8.5.1\u20132, Python Gregorian date and zoneinfo oracle",
  "cases": [
    {
      "name": "civil and timed starts share a day without collapsing",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20260101",
          "RDATE:20260101T000000Z,20260102T120000",
          "RDATE;VALUE=DATE:20260102"
        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01",
        "2026-01-01T00:00:00Z",
        "2026-01-02",
        "2026-01-02T12:00:00"
      ]
    },
    {
      "name": "DATE RDATE on a UTC rule has no clock of its own",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;VALUE=DATE:20260101,20260102"
        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01",
        "2026-01-01T09:00:00Z",
        "2026-01-02",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "floating EXDATE does not remove a UTC rule start",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE:20260102T090000"
        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "UTC EXDATE does not remove a floating rule start",
      "input": {
        "lines": [
          "DTSTART:20260101T090000",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE:20260102T090000Z"
        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01T09:00:00",
        "2026-01-02T09:00:00"
      ]
    },
    {
      "name": "floating EXDATE removes only the written wall time",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York:20260101T090000",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:20260102T090000,20260102T140000Z",
          "EXDATE:20260102T090000"
        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01T14:00:00Z",
        "2026-01-02T14:00:00Z"
      ]
    },
    {
      "name": "UTC EXDATE matches an explicit instant and leaves a floating rule",
      "input": {
        "lines": [
          "DTSTART:20260101T090000",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:20260102T090000Z",
          "EXDATE:20260102T090000Z"
        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01T09:00:00",
        "2026-01-02T09:00:00"
      ]
    },
    {
      "name": "PERIOD keeps both forms of start",
      "input": {
        "lines": [
          "DTSTART:20260101T090000",
          "RDATE;VALUE=PERIOD:20260102T120000Z/PT1H,20260102T100000/PT2H"
        ],
        "through": "2026-01-05",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01",
          "2026-01-02",
          "2026-01-03",
          "2026-01-04",
          "2026-01-05"
        ]
      },
      "expected": [
        "2026-01-01T09:00:00",
        "2026-01-02T10:00:00",
        "2026-01-02T12:00:00Z"
      ]
    },
    {
      "name": "civil EXDATE leaves timed RDATE on the same day",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20260101",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:20260102T000000,20260102T000000Z",
