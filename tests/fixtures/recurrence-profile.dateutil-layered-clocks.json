      "expected": [
        "2026-03-31T00:00:00",
        "2026-03-31T01:15:00.500"
      ]
    },
    {
      "name": "offset projections preserve microsecond identity across exclusions",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260331T000000Z",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:MAR012026.5T09:15+0300,MAR012026.500001T09:15+0300",
          "EXDATE:MAR012026.5T06:15+0000"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "checkpoints": [
          "2026-03-31"
        ],
        "through": "2026-03-31",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-03-31T00:00:00Z",
        "2026-03-31T06:15:00.500Z"
      ]
    },
    {
      "name": "the default RFC reader rejects a month followed by two clocks",
      "input": {
        "lines": [
          "DTSTART:MAR012026T09:15",
          "RRULE:FREQ=DAILY;COUNT=1"
        ],
        "through": "2026-04-01"
      },
      "expected": {
        "error": "Expected an iCalendar DATE or DATE-TIME"
      }
    }
  ]
}
