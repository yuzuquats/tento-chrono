{
  "name": "dateutil 2.8.2 immutable rule replacement",
  "source": "Python dateutil 2.8.2 rrule.replace",
  "cases": [
    {
      "name": "RRuleTest.testReplaceIfSet",
      "input": {
        "lines": [
          "DTSTART:19970101T000000",
          "RRULE:FREQ=YEARLY;COUNT=1;BYMONTHDAY=5"
        ],
        "steps": [
          {
            "bymonthday": 6
          }
        ],
        "wkst": null
      },
      "expected": {
        "original": {
          "text": "DTSTART:19970101T000000\nRRULE:FREQ=YEARLY;COUNT=1;BYMONTHDAY=5",
          "starts": [
            "1997-01-05T00:00:00"
          ]
        },
        "changes": [
          {
            "text": "DTSTART:19970101T000000\nRRULE:FREQ=YEARLY;COUNT=1;BYMONTHDAY=6",
            "starts": [
              "1997-01-06T00:00:00"
            ]
          }
        ]
      }
    },
    {
      "name": "RRuleTest.testReplaceIfNotSet",
      "input": {
        "lines": [
          "DTSTART:19970101T000000",
          "RRULE:FREQ=YEARLY;COUNT=1"
        ],
        "steps": [
          {
            "bymonthday": 6
          }
        ],
        "wkst": null
      },
      "expected": {
        "original": {
          "text": "DTSTART:19970101T000000\nRRULE:FREQ=YEARLY;COUNT=1",
          "starts": [
            "1997-01-01T00:00:00"
          ]
        },
        "changes": [
          {
            "text": "DTSTART:19970101T000000\nRRULE:FREQ=YEARLY;COUNT=1;BYMONTHDAY=6",
            "starts": [
              "1997-01-06T00:00:00"
            ]
          }
        ]
      }
    },
