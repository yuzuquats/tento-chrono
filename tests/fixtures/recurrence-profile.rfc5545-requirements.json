      "input": {
        "lines": [
          "DTSTART:20260101T235958Z",
          "RRULE:FREQ=SECONDLY;INTERVAL=2;BYSECOND=0,58;COUNT=4"
        ],
        "through": "2026-04-02"
      },
      "expected": [
        "2026-01-01T23:59:58Z",
        "2026-01-02T00:00:00Z",
