      "reference": "3.3.10",
      "input": {
        "lines": [
          "DTSTART:20241225T090000Z",
          "RRULE:FREQ=WEEKLY;INTERVAL=2;BYDAY=WE,SU;COUNT=4;WKST=MO"
        ],
        "through": "2026-04-02"
      },
      "expected": [
        "2024-12-25T09:00:00Z",
        "2024-12-29T09:00:00Z",
        "2025-01-08T09:00:00Z",
        "2025-01-12T09:00:00Z"
      ]
    },
