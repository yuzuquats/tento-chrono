    {
      "name": "setpos-count-and-exclusion-precedence",
      "reference": "3.3.10, 3.8.5.1–3",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=MONTHLY;BYMONTHDAY=1,2;BYSETPOS=1,-1;COUNT=4",
          "RDATE:20260101T090000Z,20260102T090000Z,20260301T090000Z",
          "EXDATE:20260102T090000Z"
        ],
        "through": "2026-04-02"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-02-01T09:00:00Z",
        "2026-02-02T09:00:00Z",
        "2026-03-01T09:00:00Z"
      ]
    },
    {
