{
  "type": "recurrence-profile",
  "name": "RFC 5545 recurrence requirements",
  "source": "RFC 5545 normative requirements, indicated per case",
  "cases": [
    {
      "name": "dtstart-rejects-duplicate-tzid",
      "reference": "3.8.2.4",
      "input": {
        "lines": [
          "DTSTART;TZID=America/New_York;tzid=America/Los_Angeles:20260101T090000",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-04-02"
      },
      "expected": {
        "error": "Duplicate TZID parameter"
      }
    },
    {
      "name": "dtstart-rejects-duplicate-value",
      "reference": "3.8.2.4",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE-TIME;value=DATE-TIME:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-04-02"
      },
      "expected": {
        "error": "Duplicate VALUE parameter"
      }
    },
