      ]
    },
    {
      "name": "civil-exdate-wins-over-rule-and-rdate",
      "reference": "3.3.4, 3.3.10, 3.8.5.1–3",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20260101",
