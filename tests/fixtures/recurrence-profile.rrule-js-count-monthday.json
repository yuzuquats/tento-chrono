{
  "type": "recurrence-profile",
  "name": "rrule.js 2.8.1 COUNT and BYMONTHDAY",
  "source": "rrule.js 2.8.1 rrulestr(forceset: true), TZ=UTC",
  "cases": [
    {
      "name": "negative count continues until cutoff",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=-1;UNTIL=20260103T090000Z"
        ],
        "profile": "rrule-js",
        "through": "2026-01-05",
        "checkpoints": [
          "2026-01-01"
        ]
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z",
        "2026-01-03T09:00:00Z"
      ]
    },
    {
      "name": "numeric zero count stops immediately",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=+00"
        ],
        "profile": "rrule-js",
        "through": "2026-01-05",
        "checkpoints": [
          "2026-01-01"
        ]
      },
      "expected": []
    },
