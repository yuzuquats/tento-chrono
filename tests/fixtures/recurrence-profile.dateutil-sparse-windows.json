    {
      "name": "sparse rule head retains dateutil awareness comparisons",
      "input": {
        "lines": [
          "DTSTART:20240101T000000Z",
          "RRULE:FREQ=SECONDLY;INTERVAL=86401;BYHOUR=0;BYMINUTE=0;BYSECOND=0;BYMONTH=9;COUNT=1",
          "RDATE:20240103T090000"
        ],
        "profile": "dateutil",
        "through": "4153-01-08",
        "generationLimit": null
