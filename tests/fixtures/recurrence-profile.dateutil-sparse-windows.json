      "expected": [
        "3000-01-02T00:00:00Z",
        "4153-01-08T00:00:00Z"
      ]
    },
    {
      "name": "sparse EXRULE excludes a late explicit date",
      "input": {
        "lines": [
          "DTSTART:20240101T000000Z",
          "EXRULE:FREQ=SECONDLY;INTERVAL=86401;BYHOUR=0;BYMINUTE=0;BYSECOND=0;BYMONTH=1;COUNT=2",
