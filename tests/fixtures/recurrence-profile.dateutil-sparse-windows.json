          "RDATE:30000102T000000Z,41530108T000000Z",
          "EXDATE:20240101T000000Z"
        ],
        "profile": "dateutil",
        "through": "4153-01-08",
        "checkpoints": [
          "2024-01-01",
          "2024-01-03",
          "2026-01-01",
          "2733-09-04",
          "3000-01-02",
          "4153-01-07"
        ],
        "generationLimit": null
