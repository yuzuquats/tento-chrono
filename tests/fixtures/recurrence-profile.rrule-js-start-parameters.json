{
  "type": "recurrence-profile",
  "name": "rrule.js 2.8.1 DTSTART parameter handling",
  "source": "rrule.js 2.8.1 rrulestr(forceset: true) with frozen Date",
  "cases": [
    {
      "name": "ignore VALUE=DATE",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20260301",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "profile": "rrule-js",
        "rruleJsHostTimeZone": "UTC",
        "through": "2026-03-12",
        "rruleJsNow": "2026-03-08T12:34:56Z",
        "checkpoints": [
          "2026-03-01",
          "2026-03-03",
          "2026-03-08"
        ]
      },
      "expected": [
        "2026-03-08T12:34:56Z",
        "2026-03-09T12:34:56Z"
      ]
    },
    {
      "name": "ignore VALUE=DATE-TIME",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE-TIME:20260301T080000Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "profile": "rrule-js",
        "rruleJsHostTimeZone": "UTC",
        "through": "2026-03-12",
        "rruleJsNow": "2026-03-08T12:34:56Z",
        "checkpoints": [
          "2026-03-01",
          "2026-03-03",
          "2026-03-08"
        ]
      },
      "expected": [
        "2026-03-08T12:34:56Z",
        "2026-03-09T12:34:56Z"
      ]
    },
    {
      "name": "ignore X parameter",
      "input": {
        "lines": [
          "DTSTART;X-NOTE=comment:20260301T080000Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "profile": "rrule-js",
        "rruleJsHostTimeZone": "UTC",
        "through": "2026-03-12",
        "rruleJsNow": "2026-03-08T12:34:56Z",
        "checkpoints": [
          "2026-03-01",
          "2026-03-03",
          "2026-03-08"
        ]
      },
      "expected": [
        "2026-03-08T12:34:56Z",
        "2026-03-09T12:34:56Z"
      ]
    },
    {
      "name": "ignore start before a recognized one",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20260301",
