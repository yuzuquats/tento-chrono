        "rruleJsNow": "2026-03-08T12:34:56Z",
        "checkpoints": [
          "2026-03-01",
          "2026-03-03",
          "2026-03-08"
        ]
      },
      "expected": [
        "2026-03-03",
        "2026-03-04"
      ]
    },
    {
