{
  "type": "google-expansion",
  "name": "Google Calendar late-fallback-order google-expansion",
  "source": "Google Calendar API events.instances",
  "cases": [
    {
      "name": "google-late-fallback-order-date-no-exclusion",
      "input": {
        "start": "2100-01-03",
        "rules": [
          "RDATE;VALUE=DATE:21000102",
          "RDATE;VALUE=DATE:21000104"
        ],
        "storedRecurrence": [
          "RDATE;VALUE=DATE:21000102",
          "RDATE;VALUE=DATE:21000104"
        ],
        "window": {
          "start": "2099-12-29T00:00:00Z",
          "end": "2100-01-06T00:00:00Z"
        }
      },
      "expected": {
        "google": [
          "2100-01-02"
        ]
      }
    },
    {
      "name": "google-late-fallback-order-date-rule-next",
      "input": {
