{
  "type": "recurrence-profile",
  "name": "RFC 5545 timezone observance onsets",
  "source": "RFC 5545 sections 3.3.14 and 3.6.5 with an independent Gregorian calendar oracle",
  "cases": [
    {
      "name": "STANDARD 1968 +005321 count with explicit dates",
      "input": {
        "lines": [
          "BEGIN:STANDARD",
          "DTSTART:19681110T001231",
          "TZOFFSETFROM:+005321",
          "TZOFFSETTO:+1100",
          "RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=2SU;COUNT=4",
          "RDATE:19691111T001231,19681110T001231",
          "EXDATE:19681110T001231,19701107T231910Z",
          "END:STANDARD"
        ],
        "profile": "rfc5545",
        "through": "1972-01-01",
        "checkpoints": [
          "1968-11-09",
          "1969-11-08",
          "1970-11-07",
          "1971-11-13"
        ]
      },
      "expected": [
        "1969-11-08T23:19:10Z",
        "1969-11-10T23:19:10Z",
        "1971-11-13T23:19:10Z"
      ]
    },
