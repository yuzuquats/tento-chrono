{
  "type": "recurrence-profile",
  "name": "dateutil 2.8.2 date imports",
  "source": "python-dateutil 2.8.2 rrulestr",
  "cases": [
    {
      "name": "unknown-tzid-is-floating",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART;TZID=Unknown/Somewhere:20260101T090000",
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "through": "2026-04-02"
      },
      "expected": [
        "2026-01-01T09:00:00",
        "2026-01-02T09:00:00",
        "2026-01-03T09:00:00"
      ]
    },
    {
      "name": "unresolved-tzid-allows-explicit-utc",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART;TZID=Unknown/Somewhere:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=3"
        ],
        "through": "2026-04-02"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z",
        "2026-01-03T09:00:00Z"
      ]
    },
    {
      "name": "unresolved-tzid-allows-explicit-offset",
      "input": {
        "profile": "dateutil",
        "lines": [
