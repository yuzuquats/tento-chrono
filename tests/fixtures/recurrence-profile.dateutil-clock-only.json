          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-03-01T09:15:00",
        "2026-03-02T09:15:00"
      ]
    },
    {
      "name": "a jump token before the hour leaves the clock separate",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260301T-09:15",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-01",
          "2026-03-02"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-03-01T09:15:00",
        "2026-03-02T09:15:00"
      ]
    },
    {
      "name": "a seconds-only RDATE retains its fractional seconds",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260131T000000",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:20.25S"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-01-31",
          "2026-02-01"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T00:00:00",
        "2026-01-31T00:00:20.250",
        "2026-02-01T00:00:00"
      ]
    },
    {
      "name": "a weekday and clock set the exclusion time",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260202T000000",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE:MON-09:15"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-02-02",
          "2026-02-03"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
