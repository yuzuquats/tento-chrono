        "2026-02-03T00:00:00"
      ]
    },
    {
      "name": "an inherited-date UNTIL includes the matching day",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260131T000000",
          "RRULE:FREQ=DAILY;UNTIL=12PM"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-01-31"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T00:00:00"
      ]
    },
    {
      "name": "a clock inherits the supplied host date before applying its offset",
      "input": {
        "profile": "dateutil",
        "dateutilNow": "2026-01-01T02:00:00Z",
        "dateutilHost": {
          "names": [
            "EST",
            "EDT"
          ],
          "standardOffsetSeconds": -18000,
          "daylightOffsetSeconds": -14400,
          "localTime": [
            [
              0,
              false,
              -18000
            ]
          ]
        },
        "lines": [
          "DTSTART:09:15EST",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-01"
      },
      "expected": [
        "2025-12-31T14:15:00Z",
        "2026-01-01T14:15:00Z"
      ]
    },
    {
      "name": "a three-digit hour token is read as one number",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260301T001PM",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-03-01",
          "2026-03-02"
        ]
      },
      "expected": [
        "2026-03-01T13:00:00",
        "2026-03-02T13:00:00"
      ]
    },
    {
      "name": "a complete date changes how a two-digit meridiem hour is checked",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:2026-03-01-13PM",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": []
      },
      "expected": {
        "error": "Unknown string format: 2026-03-01-13PM"
      }
    },
    {
      "name": "a bare six-digit token is a date before the M separator",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:091530M",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2031-12-31",
        "checkpoints": [
          "2030-09-15",
          "2030-09-16"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2030-09-15",
        "2030-09-16"
      ]
    },
    {
      "name": "a bare six-digit token prevents H from supplying an hour",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:091530H",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": {
        "error": "Unknown string format: 091530H"
      }
    },
    {
      "name": "the default RFC reader requires the date before a clock",
      "input": {
        "lines": [
          "DTSTART:09:15",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-31"
      },
      "expected": {
        "error": "Expected an iCalendar DATE or DATE-TIME"
      }
    }
  ]
}
