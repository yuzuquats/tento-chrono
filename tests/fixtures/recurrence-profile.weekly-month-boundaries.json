{
  "type": "recurrence-profile",
  "name": "Weekly month boundaries and position counting",
  "source": "RFC 5545 section 3.3.10 Gregorian week enumeration, dateutil 2.8.2 and rrule.js 2.8.1 under TZ=UTC",
  "cases": [
    {
      "name": "weekly-month-boundary-inherits-dtstart-weekday",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20260101",
          "RRULE:FREQ=WEEKLY;INTERVAL=3;WKST=MO;BYMONTH=1,4;BYSETPOS=1,3,-1;COUNT=8"
        ],
        "through": "2030-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-08",
          "2026-03-02"
        ]
      },
      "expected": [
        "2026-01-01",
        "2026-01-22",
        "2026-04-16",
        "2027-01-14",
        "2027-04-08",
        "2027-04-29",
        "2028-01-06",
        "2028-01-27"
      ]
    },
    {
      "name": "weekly-month-boundary-ranks-clock-positions",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=WEEKLY;INTERVAL=3;WKST=MO;BYMONTH=1,4;BYDAY=TH,FR,SA;BYHOUR=9,12,17;BYSETPOS=1,3,-1;COUNT=8"
        ],
        "through": "2030-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-08",
          "2026-03-02"
        ]
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-01T17:00:00Z",
        "2026-01-03T17:00:00Z",
        "2026-01-22T09:00:00Z",
        "2026-01-22T17:00:00Z",
        "2026-01-24T17:00:00Z",
        "2026-04-16T09:00:00Z",
        "2026-04-16T17:00:00Z"
      ]
    },
    {
      "name": "weekly-month-boundary-rfc-deduplicates-leap-day-positions",
      "input": {
        "lines": [
          "DTSTART:20000229T090000Z",
          "RRULE:FREQ=WEEKLY;INTERVAL=1;WKST=MO;BYMONTH=2,5;BYDAY=TU,WE,TH;BYSETPOS=1,3,-1;COUNT=8"
        ],
        "through": "2004-12-31",
        "checkpoints": [
          "2000-02-29",
          "2000-03-07",
          "2000-03-30"
        ]
      },
      "expected": [
        "2000-02-29T09:00:00Z",
        "2000-05-02T09:00:00Z",
        "2000-05-04T09:00:00Z",
        "2000-05-09T09:00:00Z",
        "2000-05-11T09:00:00Z",
        "2000-05-16T09:00:00Z",
        "2000-05-18T09:00:00Z",
        "2000-05-23T09:00:00Z"
      ]
    },
    {
      "name": "weekly-month-boundary-dateutil-deduplicates-leap-day-positions",
      "input": {
        "lines": [
          "DTSTART:20000229T090000Z",
          "RRULE:FREQ=WEEKLY;INTERVAL=1;WKST=MO;BYMONTH=2,5;BYDAY=TU,WE,TH;BYSETPOS=1,3,-1;COUNT=8"
        ],
        "through": "2004-12-31",
        "checkpoints": [
          "2000-02-29",
          "2000-03-07",
          "2000-03-30"
        ],
        "profile": "dateutil"
      },
      "expected": [
        "2000-02-29T09:00:00Z",
        "2000-05-02T09:00:00Z",
        "2000-05-04T09:00:00Z",
        "2000-05-09T09:00:00Z",
        "2000-05-11T09:00:00Z",
        "2000-05-16T09:00:00Z",
        "2000-05-18T09:00:00Z",
        "2000-05-23T09:00:00Z"
