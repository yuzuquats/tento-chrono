{
  "type": "recurrence-profile",
  "name": "RFC 5545 content-line parameters",
  "source": "RFC 5545 §3.1 content-line parameter ABNF",
  "cases": [
    {
      "name": "DTSTART 'X-NOTE'",
      "reference": "RFC 5545 §3.1 content-line parameter ABNF",
      "input": {
        "lines": [
          "DTSTART;X-NOTE:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-03"
      },
      "expected": {
        "error": "Invalid DTSTART parameter"
      }
    },
    {
      "name": "RRULE 'X-NOTE=ab\"quoted\"cd'",
      "reference": "RFC 5545 §3.1 content-line parameter ABNF",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE;X-NOTE=ab\"quoted\"cd:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-03"
      },
      "expected": {
        "error": "Invalid RRULE parameter"
      }
    },
    {
      "name": "RDATE 'X_NOTE=tag'",
      "reference": "RFC 5545 §3.1 content-line parameter ABNF",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;X_NOTE=tag:20260103T090000Z"
        ],
        "through": "2026-01-03"
      },
      "expected": {
        "error": "Invalid RDATE parameter"
      }
    },
    {
      "name": "EXDATE ' X-NOTE=tag'",
      "reference": "RFC 5545 §3.1 content-line parameter ABNF",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
