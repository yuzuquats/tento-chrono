        "through": "2026-01-03"
      },
      "expected": {
        "error": "Invalid RDATE parameter"
      }
    },
    {
      "name": "EXDATE 'X-NOTE=\"quoted\\x7fvalue\"'",
      "reference": "RFC 5545 §3.1 content-line parameter ABNF",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE;X-NOTE=\"quotedvalue\":20260101T090000Z"
        ],
        "through": "2026-01-03"
      },
      "expected": {
        "error": "Invalid EXDATE parameter"
      }
    },
    {
      "name": "DTSTART 'X-NOTE=\"quoted\"x,bare'",
      "reference": "RFC 5545 §3.1 content-line parameter ABNF",
      "input": {
        "lines": [
          "DTSTART;X-NOTE=\"quoted\"x,bare:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-03"
      },
      "expected": {
