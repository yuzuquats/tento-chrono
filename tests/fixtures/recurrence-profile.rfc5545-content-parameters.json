        ],
        "through": "2026-01-03"
      },
      "expected": {
        "error": "Invalid EXDATE parameter"
      }
    },
    {
      "name": "RRULE '=tag'",
      "reference": "RFC 5545 §3.1 content-line parameter ABNF",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE;=tag:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-01-03"
      },
      "expected": {
        "error": "Invalid RRULE parameter"
      }
    },
    {
      "name": "RDATE 'X-NOTE=bare\\x01value'",
      "reference": "RFC 5545 §3.1 content-line parameter ABNF",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE;X-NOTE=bare\u0001value:20260103T090000Z"
