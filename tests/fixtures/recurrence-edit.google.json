{
  "type": "recurrence-edit",
  "name": "Google recurrence edit round trips",
  "source": "Google Calendar recurrence date forms captured on the maintainer's capture host and local edit expectations",
  "cases": [
    {
      "name": "split preserves a quoted extension containing delimiters",
      "input": {
        "kind": "split",
        "lines": ["RDATE;X-NOTE=\"A:B;C=D\":20270107T090000Z,20270109T090000Z"],
        "start": "2027-01-04T09:00:00Z",
        "cut": "2027-01-08T00:00:00Z"
      },
      "expected": {
        "before": ["RDATE;X-NOTE=\"A:B;C=D\":20270107T090000Z"],
        "from": ["RDATE;X-NOTE=\"A:B;C=D\":20270109T090000Z"]
      }
    },
    {
      "name": "split uses the fixed-offset instant and keeps an exact cut",
      "input": {
        "kind": "split",
        "lines": [
          "RDATE;TZID=\"GMT+02:30\":20270108T000000,20270109T000000,20270107T230000Z"
        ],
        "start": "2027-01-04T09:00:00Z",
        "cut": "2027-01-07T23:00:00Z"
      },
      "expected": {
        "before": ["RDATE;TZID=\"GMT+02:30\":20270108T000000"],
        "from": ["RDATE;TZID=\"GMT+02:30\":20270109T000000,20270107T230000Z"]
      }
    },
    {
      "name": "split compares DATE, floating and UTC by their Google instants",
      "input": {
        "kind": "split",
        "lines": [
          "RDATE;VALUE=DATE;TZID=Not/AZone:20270108,20270108T010000,20270108T020000Z"
        ],
        "start": "2027-01-04T09:00:00-05:00",
        "timezone": "America/New_York",
        "cut": "2027-01-08T02:00:00Z"
      },
      "expected": {
        "before": ["RDATE;VALUE=DATE;TZID=Not/AZone:20270108"],
        "from": [
          "RDATE;VALUE=DATE;TZID=Not/AZone:20270108T010000,20270108T020000Z"
        ]
      }
    },
    {
      "name": "split uses the first instant for a quoted named fold",
      "input": {
        "kind": "split",
        "lines": [
          "RDATE;TZID=\"America/New_York\":20261101T013000,20261101T063000Z"
        ],
        "start": "2026-01-01T09:00:00Z",
        "cut": "2026-11-01T06:00:00Z"
      },
      "expected": {
        "before": ["RDATE;TZID=\"America/New_York\":20261101T013000"],
        "from": ["RDATE;TZID=\"America/New_York\":20261101T063000Z"]
      }
    },
    {
      "name": "move preserves a quoted extension containing delimiters",
      "input": {
        "kind": "move",
        "lines": ["RDATE;X-NOTE=\"A:B;C=D\":20270107T090000Z,20270109T090000Z"],
        "shift": { "days": 1, "wallMs": 86400000, "toAllDay": false }
      },
      "expected": ["RDATE;X-NOTE=\"A:B;C=D\":20270108T090000Z,20270110T090000Z"]
    },
    {
      "name": "move reprojects a quoted fixed-offset date through a DST change",
      "input": {
        "kind": "move",
        "lines": ["EXDATE;TZID=\"GMT+02:30\":20260307T163000"],
        "timezone": "America/New_York",
        "shift": { "days": 1, "wallMs": 86400000, "toAllDay": false }
      },
      "expected": ["EXDATE;TZID=\"GMT+02:30\":20260308T153000"]
    },
    {
      "name": "retaining EXDATEs preserves extension-only and mixed DATE parameters",
      "input": {
        "kind": "rewrite",
        "lines": [
          "RRULE:FREQ=DAILY;COUNT=5",
          "EXDATE;X-NOTE=\"A:B;C=D\":20270107T090000Z",
          "EXDATE;VALUE=DATE;TZID=\"GMT+02:30\":20270108,20270109T090000"
        ]
      },
      "expected": [
        "RRULE:FREQ=DAILY;COUNT=5",
        "EXDATE;X-NOTE=\"A:B;C=D\":20270107T090000Z",
        "EXDATE;VALUE=DATE;TZID=\"GMT+02:30\":20270108,20270109T090000"
      ]
    },
    {
      "name": "fixed-offset exclusions can be checked without a timezone cache",
      "input": {
        "kind": "exclusions",
        "lines": ["EXDATE;TZID=\"GMT+02:30\":20270108T000000"],
        "starts": ["2027-01-07T21:30:00Z", "2027-01-08T00:00:00Z"]
      },
      "expected": [true, false]
    },
    {
      "name": "a quoted same-zone EXDATE excludes only the first fold instant",
      "input": {
        "kind": "exclusions",
        "lines": ["EXDATE;TZID=\"America/New_York\":20261101T013000"],
        "timezone": "America/New_York",
        "starts": ["2026-11-01T05:30:00Z", "2026-11-01T06:30:00Z"]
      },
      "expected": [true, false]
    },
    {
      "name": "move preserves opaque PERIOD suffixes and shifts their starts",
      "input": {
        "kind": "move",
        "lines": [
          "RDATE;VALUE=PERIOD:20270108T140000Z/foo,20270109T140000Z/20270109T150000Z"
        ],
        "shift": { "days": 1, "wallMs": 86400000, "toAllDay": false }
      },
      "expected": [
        "RDATE;VALUE=PERIOD:20270109T140000Z/foo,20270110T140000Z/20270110T150000Z"
      ]
    },
    {
      "name": "move uses the series offset after the last served timezone year",
      "input": {
        "kind": "move",
        "lines": ["EXDATE;TZID=\"GMT+02:30\":20750309T163000"],
        "timezone": "America/New_York",
        "shift": { "days": 1, "wallMs": 86400000, "toAllDay": false }
      },
      "expected": ["EXDATE;TZID=\"GMT+02:30\":20750310T153000"]
    },
    {
      "name": "split separates summer floating and UTC values beyond the table",
      "input": {
        "kind": "split",
        "lines": ["RDATE:20750708T090000,20750708T140000Z"],
        "timezone": "America/New_York",
        "start": "2075-01-04T09:00:00-05:00",
        "cut": "2075-07-08T13:30:00Z"
      },
      "expected": {
        "before": ["RDATE:20750708T090000"],
        "from": ["RDATE:20750708T140000Z"]
      }
    },
    {
      "name": "serialization retains fixed-offset parameter quoting",
      "input": {
        "kind": "rewrite",
        "zones": ["GMT+02:30"],
        "lines": [
          "DTSTART;TZID=\"GMT+02:30\":20270104T090000",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE;TZID=\"GMT+02:30\":20270105T090000",
          "RDATE;TZID=\"GMT+02:30\":20270108T000000"
        ]
      },
      "expected": [
        "DTSTART;TZID=\"GMT+02:30\":20270104T090000",
        "RRULE:FREQ=DAILY;COUNT=2",
        "EXDATE;TZID=\"GMT+02:30\":20270105T090000",
        "RDATE;TZID=\"GMT+02:30\":20270108T000000"
      ]
    }
  ]
}
