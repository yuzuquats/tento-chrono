{
  "type": "recurrence-profile",
  "name": "RFC 5545 DATE clock selectors",
  "source": "RFC 5545 \u00a73.3.10, dateutil 2.8.2 and Python Gregorian calendar after omitting clock selectors",
  "cases": [
    {
      "name": "DATE daily ignores clocks and applies civil inclusions and exclusions",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20240101",
          "RRULE:FREQ=DAILY;UNTIL=20240108;BYHOUR=6,14;BYMINUTE=0,30;BYSECOND=0,59",
          "EXDATE;VALUE=DATE:20240101",
          "RDATE;VALUE=DATE:20231230,20240301"
        ],
        "through": "2028-03-14",
        "checkpoints": [
          "2023-12-30",
          "2024-01-01",
          "2024-01-02",
          "2024-01-05",
          "2024-03-02",
          "2024-12-31"
        ]
      },
      "expected": [
        "2023-12-30",
        "2024-01-02",
        "2024-01-03",
        "2024-01-04",
        "2024-01-05",
        "2024-01-06",
        "2024-01-07",
        "2024-01-08",
        "2024-03-01"
      ]
    },
    {
      "name": "DATE weekly BYSETPOS ranks whole days",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20240101",
          "RRULE:FREQ=WEEKLY;BYDAY=MO,WE,FR;WKST=SU;BYSETPOS=1,-1;UNTIL=20240108;BYHOUR=6,14;BYMINUTE=0,30;BYSECOND=0,59"
        ],
        "through": "2028-03-14",
        "checkpoints": [
          "2023-12-30",
          "2024-01-01",
          "2024-01-02",
          "2024-01-05",
          "2024-03-02",
          "2024-12-31"
        ]
      },
      "expected": [
        "2024-01-01",
        "2024-01-05",
        "2024-01-08"
      ]
    },
    {
      "name": "DATE monthly COUNT stays independent of clock selectors",
      "input": {
        "lines": [
          "DTSTART;VALUE=DATE:20240101",
          "RRULE:FREQ=MONTHLY;BYDAY=MO,FR;BYSETPOS=1,-1;COUNT=8;BYHOUR=6,14;BYMINUTE=0,30;BYSECOND=0,59"
