{
  "type": "platform-recurrence",
  "name": "IANA historical offset seconds",
  "source": "Python zoneinfo, IANA tzdata 2026e",
  "cases": [
    {
      "name": "Monrovia preserves a negative thirty-second offset across its gap",
      "input": {
        "lines": [
          "DTSTART;TZID=Africa/Monrovia:19720106T230000",
          "RRULE:FREQ=HOURLY;COUNT=4"
        ],
        "through": "1972-01-07",
        "checkpoints": [
          "1972-01-06",
          "1972-01-07"
        ]
      },
      "expected": [
        "1972-01-06T23:44:30Z",
        "1972-01-07T00:44:30Z",
        "1972-01-07T01:00:00Z",
        "1972-01-07T02:00:00Z"
      ]
    },
