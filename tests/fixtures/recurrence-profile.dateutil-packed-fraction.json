{
  "type": "recurrence-profile",
  "name": "Dateutil packed fractional clocks",
  "source": "python-dateutil 2.8.2 rrulestr with a frozen process-local date",
  "cases": [
    {
      "name": "a six-digit fractional clock inherits the local date",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:091530.5",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-01-31",
          "2026-02-01"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T09:15:30",
        "2026-02-01T09:15:30"
      ]
    },
    {
      "name": "a UTC clock can inherit leap day",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2028,
        "lines": [
          "DTSTART:091530.000001Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2029-12-31",
        "checkpoints": [
          "2028-02-29",
          "2028-03-01"
        ],
        "dateutilNow": "2028-02-29T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2028-02-29T09:15:30Z",
        "2028-03-01T09:15:30Z"
      ]
    },
    {
      "name": "AM changes the hour while preserving the lower clock fields",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:121530.5AM",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-01-31",
          "2026-02-01"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T00:15:30",
        "2026-02-01T00:15:30"
      ]
    },
    {
      "name": "a packed fractional hour above twelve fails the meridiem check",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:231530.5AM",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": {
        "error": "Unknown string format: 231530.5AM"
      }
    },
    {
      "name": "an adjacent M timezone label reverses the written offset",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:091530.123456789P.M+3",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-02-01",
          "2026-02-02"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-02-01T00:15:30Z",
        "2026-02-02T00:15:30Z"
      ]
    },
    {
      "name": "weekday advancement keeps the packed clock and trailing zone label",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:MON-091530.5H",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-02-02",
          "2026-02-03"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-02-02T09:15:30",
        "2026-02-03T09:15:30"
      ]
    },
    {
      "name": "an invalid packed minute reports the same error with a written date",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260301T096030.5",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": []
      },
      "expected": {
        "error": "minute must be in 0..59: 20260301T096030.5"
      }
    },
    {
      "name": "an invalid packed hour reports the clock range error",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:240000.25",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2027-12-31",
        "checkpoints": [],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": {
        "error": "hour must be in 0..23: 240000.25"
      }
    },
    {
      "name": "an offset RDATE projects the truncated fractional seconds",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260131T033000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:091530.123456789-0330"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-01-31",
          "2026-02-01"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T03:30:00Z",
        "2026-01-31T12:45:30.123Z",
        "2026-02-01T03:30:00Z"
      ]
    },
    {
      "name": "H is a zone label after a complete fractional clock",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260131T030000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:091530.123456789H+3"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-01-31",
          "2026-02-01"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T03:00:00Z",
        "2026-01-31T12:15:30.123Z",
        "2026-02-01T03:00:00Z"
      ]
    },
    {
      "name": "a packed EXDATE inherits leap day",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2028,
        "lines": [
          "DTSTART:20280229T000000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE:091530.000999Z"
        ],
        "through": "2029-12-31",
        "checkpoints": [
          "2028-02-29",
          "2028-03-01"
        ],
        "dateutilNow": "2028-02-29T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2028-02-29T00:00:00Z",
        "2028-03-01T00:00:00Z"
      ]
    },
    {
      "name": "an undated packed UNTIL ends on the process-local date",
      "input": {
        "profile": "dateutil",
        "dateutilParserYear": 2026,
        "lines": [
          "DTSTART:20260131T000000Z",
          "RRULE:FREQ=DAILY;UNTIL=091530.5Z"
        ],
        "through": "2027-12-31",
        "checkpoints": [
          "2026-01-31"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T00:00:00Z"
      ]
    },
    {
      "name": "distinct microseconds can produce duplicate millisecond starts",
      "input": {
        "profile": "dateutil",
        "dateutilNow": "2026-01-31T12:00:00Z",
        "lines": [
          "DTSTART:20260131T003000",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:091530.123456,091530.123457"
        ],
        "through": "2026-01-31",
        "checkpoints": [
          "2026-01-31"
        ],
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T00:30:00",
        "2026-01-31T09:15:30.123",
        "2026-01-31T09:15:30.123"
      ]
    },
    {
      "name": "EXDATE removes one microsecond before projection",
      "input": {
        "profile": "dateutil",
        "dateutilNow": "2026-01-31T12:00:00Z",
        "lines": [
          "DTSTART:20260131T003000",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:091530.123456,091530.123457",
          "EXDATE:091530.123456"
        ],
        "through": "2026-01-31",
        "checkpoints": [
          "2026-01-31"
        ],
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T00:30:00",
        "2026-01-31T09:15:30.123"
      ]
    },
    {
      "name": "offset and UTC dates compare at microsecond precision",
      "input": {
        "profile": "dateutil",
        "dateutilNow": "2026-01-31T12:00:00Z",
        "lines": [
          "DTSTART:20260131T003000Z",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:091530.123456Z,041530.123457-0500",
          "EXDATE:091530.123456Z"
        ],
        "through": "2026-01-31",
        "checkpoints": [
          "2026-01-31"
        ],
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T00:30:00Z",
        "2026-01-31T09:15:30.123Z"
      ]
    },
    {
      "name": "inherited local date projects into the following UTC window",
      "input": {
        "profile": "dateutil",
        "dateutilNow": "2026-01-31T12:00:00Z",
        "lines": [
          "DTSTART:20260131T003000Z",
          "RRULE:FREQ=DAILY;COUNT=1",
          "RDATE:230000.5-0330"
        ],
        "through": "2026-02-01",
        "checkpoints": [
          "2026-01-31",
          "2026-02-01"
        ],
        "dateutilHost": {
          "names": [
            "UTC",
            "UTC"
          ],
          "standardOffsetSeconds": 0,
          "daylightOffsetSeconds": 0,
          "localTime": [
            [
              0,
              false,
              0
            ]
          ]
        }
      },
      "expected": [
        "2026-01-31T00:30:00Z",
        "2026-02-01T02:30:00.500Z"
      ]
    },
    {
      "name": "the default RFC reader rejects an undated fractional clock",
      "input": {
        "lines": [
          "DTSTART:091530.5",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-02-02"
      },
      "expected": {
        "error": "Expected an iCalendar DATE or DATE-TIME"
      }
    }
  ]
}
