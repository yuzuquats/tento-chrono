{
  "type": "recurrence-profile",
  "name": "dateutil integer selector bounds",
  "source": "python-dateutil 2.8.2 with 64-bit CPython integer conversion",
  "cases": [
    {
      "name": "daily-hour-above-c-int",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=DAILY;INTERVAL=2;BYHOUR=2147483648;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": {
        "error": "signed integer is greater than maximum"
      }
    },
    {
      "name": "daily-hour-below-c-int",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=DAILY;INTERVAL=2;BYHOUR=-2147483649;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": {
        "error": "signed integer is less than minimum"
      }
    },
    {
      "name": "hourly-minute-at-c-long-max",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=HOURLY;INTERVAL=2;BYMINUTE=9223372036854775807;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": {
        "expansionError": "signed integer is greater than maximum"
      }
    },
    {
      "name": "hourly-minute-above-c-long-max",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=HOURLY;INTERVAL=2;BYMINUTE=9223372036854775808;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": {
        "expansionError": "Python int too large to convert to C long"
      }
    },
    {
      "name": "hourly-minute-at-c-long-min",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=HOURLY;INTERVAL=2;BYMINUTE=-9223372036854775808;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": {
        "expansionError": "signed integer is less than minimum"
      }
    },
    {
      "name": "hourly-minute-below-c-long-min",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=HOURLY;INTERVAL=2;BYMINUTE=-9223372036854775809;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": {
        "expansionError": "Python int too large to convert to C long"
      }
    },
    {
      "name": "secondly-clock-phase-uses-exact-odd-integer",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=SECONDLY;INTERVAL=2;BYSECOND=9007199254740993;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": {
        "error": "Invalid rrule byxxx generates an empty set."
      }
    },
    {
      "name": "secondly-clock-phase-keeps-valid-zero",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=SECONDLY;INTERVAL=2;BYSECOND=0,9007199254740993;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": [
        "9999-12-30T00:00:00Z"
      ]
    },
