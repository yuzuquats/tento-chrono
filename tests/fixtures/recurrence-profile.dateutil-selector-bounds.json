    {
      "name": "ordinary-date-keeps-valid-byweekno",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260306T090000Z",
          "RRULE:FREQ=YEARLY;,10;UNTIL=20261231T235959Z"
        ],
        "through": "2027-01-01",
        "checkpoints": [
          "2026-03-05",
          "2026-03-06"
        ]
      },
      "expected": [
        "2026-03-06T09:00:00Z",
        "2026-03-07T09:00:00Z",
