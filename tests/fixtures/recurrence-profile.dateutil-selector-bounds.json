    {
      "name": "easter-mask-precedes-subdaily-clock",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=HOURLY;BYMINUTE=2147483648;BYEASTER=400;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "9999-12-30"
        ]
      },
      "expected": {
