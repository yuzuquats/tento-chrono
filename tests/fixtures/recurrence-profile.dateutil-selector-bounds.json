    },
    {
      "name": "easter-oversized-magnitude-first-in-order",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:99991230T000000Z",
          "RRULE:FREQ=YEARLY;BYEASTER=400,-;COUNT=1"
