{
  "type": "rrule-js-neighbors",
  "name": "rrule.js set rule identity and query order",
  "source": "rrule.js 2.8.1 RRuleSet before(), after(), between() and rrules()",
  "cases": [
    {
      "name": "rrulejs-set-identity-utc-empty-minute-omitted-0-morning",
      "input": {
        "lines": [
          "DTSTART:99991101T000000Z",
          "RRULE:FREQ=DAILY;BYHOUR=18,9;COUNT=6;UNTIL=99991104T000000Z",
          "RRULE:FREQ=DAILY;BYHOUR=18,9;COUNT=6;UNTIL=99991104T000000Z;BYMINUTE="
        ],
        "rruleJsHostTimeZone": "UTC",
        "rruleJsForceSet": true,
        "after": "9999-11-01T00:00:00Z",
        "before": "9999-11-01T12:00:00Z",
        "inclusive": true
      },
      "expected": {
        "after": "9999-11-01T18:00:00Z",
        "before": null
      }
    },
    {
      "name": "rrulejs-set-identity-utc-empty-minute-omitted-1-morning",
