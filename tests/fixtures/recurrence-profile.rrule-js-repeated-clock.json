{
  "type": "recurrence-profile",
  "name": "rrule.js 2.8.1 repeated clock selectors",
  "source": "rrulestr 2.8.1 with forceset true and the fixture process timezone",
  "cases": [
    {
      "name": "daily-repeated-hours",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;BYHOUR=9,9;COUNT=4"
        ],
        "profile": "rrule-js",
        "through": "2026-06-01"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "hourly-repeated-minutes",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=HOURLY;BYMINUTE=0,0;COUNT=4"
        ],
        "profile": "rrule-js",
        "through": "2026-06-01"
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-01T10:00:00Z"
      ]
    },
    {
      "name": "minutely-repeated-seconds",
      "input": {
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=MINUTELY;BYSECOND=0,0;COUNT=4"
