    {
      "name": "yearly-first-mixed-numbered",
      "input": {
        "graph": {
          "start": {
            "dateTime": "2027-02-01T09:00:00.0000000",
            "timeZone": "UTC"
          },
          "originalStartTimeZone": "UTC",
          "isAllDay": false,
          "recurrence": {
            "pattern": {
              "dayOfMonth": 0,
              "daysOfWeek": [
                "monday",
                "friday"
              ],
              "firstDayOfWeek": "sunday",
              "index": "first",
              "interval": 1,
              "month": 2,
              "type": "relativeYearly"
            },
            "range": {
              "endDate": "0001-01-01",
              "numberOfOccurrences": 3,
              "recurrenceTimeZone": "UTC",
              "startDate": "2027-02-01",
              "type": "numbered"
            }
          }
        },
        "through": "2029-02-28",
        "checkpoints": [
          "2027-02-01",
          "2028-02-04",
          "2029-02-02"
        ]
      },
      "expected": [
        "2027-02-01T09:00:00Z",
        "2028-02-04T09:00:00Z",
        "2029-02-02T09:00:00Z"
