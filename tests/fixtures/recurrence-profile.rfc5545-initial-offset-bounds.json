{
  "type": "recurrence-profile",
  "name": "RFC 5545 query bounds before the first timezone transition",
  "source": "RFC 5545 sections 3.3.5 and 3.3.10 with independent fixed-offset arithmetic",
  "cases": [
    {
      "name": "initial-zone-bounds-positive-query",
      "input": {
        "lines": [
          "DTSTART;TZID=X-Calendar:20260101T020000",
          "RRULE:FREQ=DAILY;COUNT=4"
        ],
        "through": "2026-01-01",
        "checkpoints": [
          "2025-12-31"
        ],
        "rfcTimeZones": {
          "X-Calendar": {
            "transitions": [
              {
                "before": "2026-03-01T12:00:00+14:00",
                "after": "2026-03-01T11:00:00+13:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              }
            ]
          }
        }
      },
      "expected": [
        "2025-12-31T12:00:00Z",
        "2026-01-01T12:00:00Z"
      ]
    },
    {
      "name": "initial-zone-bounds-positive-until",
      "input": {
        "lines": [
          "DTSTART;TZID=X-Calendar:20260101T020000",
          "RRULE:FREQ=DAILY;UNTIL=20260101T120000Z"
        ],
        "through": "2026-01-03",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01"
        ],
        "rfcTimeZones": {
          "X-Calendar": {
            "transitions": [
              {
                "before": "2026-03-01T12:00:00+14:00",
                "after": "2026-03-01T11:00:00+13:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              }
            ]
          }
        }
      },
      "expected": [
        "2025-12-31T12:00:00Z",
        "2026-01-01T12:00:00Z"
      ]
    },
    {
      "name": "initial-zone-bounds-negative-control",
      "input": {
        "lines": [
          "DTSTART;TZID=X-Calendar:20260101T220000",
          "RRULE:FREQ=DAILY;UNTIL=20260102T090000Z"
        ],
        "through": "2026-01-03",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02"
        ],
        "rfcTimeZones": {
          "X-Calendar": {
            "transitions": [
              {
                "before": "2026-03-01T12:00:00-11:00",
                "after": "2026-03-01T13:00:00-10:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              }
            ]
          }
        }
      },
      "expected": [
        "2026-01-02T09:00:00Z"
      ]
    },
    {
      "name": "initial-zone-bounds-hourly-cutoff",
      "input": {
        "lines": [
          "DTSTART;TZID=X-Calendar:20260102T000000",
          "RRULE:FREQ=HOURLY;UNTIL=20260101T211500Z"
        ],
        "through": "2026-01-02",
        "checkpoints": [
          "2025-12-31",
          "2026-01-01"
        ],
        "rfcTimeZones": {
          "X-Calendar": {
            "transitions": [
              {
                "before": "2026-03-01T12:00:00+05:45",
                "after": "2026-03-01T12:15:00+06:00",
                "before_tz_abbr": "FIX",
                "after_tz_abbr": "FIX"
              }
            ]
          }
        }
      },
      "expected": [
        "2026-01-01T18:15:00Z",
        "2026-01-01T19:15:00Z",
        "2026-01-01T20:15:00Z",
        "2026-01-01T21:15:00Z"
      ]
    }
  ]
}
