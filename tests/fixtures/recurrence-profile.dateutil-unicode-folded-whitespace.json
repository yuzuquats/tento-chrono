{
  "type": "recurrence-profile",
  "name": "Dateutil Unicode whitespace in folded dates",
  "source": "python-dateutil 2.8.2 rrulestr with forceset and unfold",
  "cases": [
    {
      "name": "nonbreaking spaces separate named month fields",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:2\r\n \u00a0JAN\u00a02026\u00a009:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-01-02T09:30:00",
        "2026-01-03T09:30:00"
      ]
    },
    {
      "name": "em spaces separate numeric fields and preserve UTC",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;COUNT=2",
          "RDATE:2026\r\n \u20031\u20032\u200309:30Z"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-01-01T09:00:00Z",
        "2026-01-02T09:00:00Z",
        "2026-01-02T09:30:00Z"
      ]
    },
    {
      "name": "narrow nonbreaking spaces preserve the month-of-year phrase",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:FEB\r\n \u202fOF\u202f26\u202f09:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-02-28T09:30:00",
        "2026-03-01T09:30:00"
      ]
    },
    {
      "name": "unit separators can survive a fold and separate calendar words",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260101T090000",
          "RRULE:FREQ=DAILY;COUNT=2",
          "EXDATE:ON\r\n \u001f2\u001fJAN\u001f2026\u001fAT\u001f09:00"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-01-01T09:00:00"
      ]
    },
    {
      "name": "nonbreaking space retains a mixed-delimiter UNTIL",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260101T090000Z",
          "RRULE:FREQ=DAILY;UNTIL=JAN-2/2026\r\n \u00a009:00Z"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": {
        "error": "unknown parameter name"
      }
    },
    {
      "name": "an em space can follow the explicit clock designator",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:20260102\r\n \u2003T\u2003090000Z",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": [
        "2026-01-02T09:00:00Z",
        "2026-01-03T09:00:00Z"
      ]
    },
    {
      "name": "an unknown month keeps the original Unicode space in its error",
      "input": {
        "profile": "dateutil",
        "lines": [
          "DTSTART:2\r\n \u202fJanu\u202f2026\u202f09:30",
          "RRULE:FREQ=DAILY;COUNT=2"
        ],
        "through": "2026-12-31",
        "checkpoints": [
          "2026-01-01",
          "2026-01-02",
          "2026-03-06"
        ],
        "dateutilNow": "2026-01-31T12:00:00Z",
        "dateutilParserYear": 2026
      },
      "expected": {
        "error": "Unknown string format: 2\u202fJANU\u202f2026\u202f09:30"
      }
    }
  ]
}
