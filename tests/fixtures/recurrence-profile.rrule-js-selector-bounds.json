{
  "type": "recurrence-profile",
  "name": "rrule.js integer selector bounds",
  "source": "rrule.js 2.8.1 under TZ=UTC",
  "cases": [
    {
      "name": "yearly-does-not-default-overflowing-hour",
      "input": {
        "profile": "rrule-js",
        "lines": [
          "DTSTART:99991230T090000Z",
          "RRULE:FREQ=YEARLY;;COUNT=1"
        ],
        "through": "9999-12-31",
        "checkpoints": [
          "2026-03-06",
          "9999-12-30"
        ]
      },
      "expected": []
    },
    {
