{
  "type": "recurrence-profile",
  "name": "Subdaily fractional starts around the Unix epoch",
  "source": "Gregorian subdaily enumeration, python-dateutil 2.8.2, and rrule.js 2.8.1 under TZ=UTC",
  "cases": [
    {
      "name": "rfc5545-fractional-start-before-unix-epoch",
      "input": {
        "dtstart": {
          "dateTime": "1969-12-31T23:59:59.125Z"
        },
        "lines": [
          "RRULE:FREQ=SECONDLY;INTERVAL=1;COUNT=8"
        ],
        "through": "1970-01-03",
        "checkpoints": [
          "1969-12-31",
          "1970-01-01"
        ]
      },
      "expected": [
        "1969-12-31T23:59:59.125Z",
        "1970-01-01T00:00:00.125Z",
        "1970-01-01T00:00:01.125Z",
        "1970-01-01T00:00:02.125Z",
        "1970-01-01T00:00:03.125Z",
        "1970-01-01T00:00:04.125Z",
        "1970-01-01T00:00:05.125Z",
        "1970-01-01T00:00:06.125Z"
      ]
    },
    {
      "name": "rfc5545-fractional-start-at-unix-epoch",
