{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "types": []
  },
  "include": [
    "chrono/**/*.ts"
  ],
  "exclude": [
    "**/*.deno.ts",
    "**/*.deno.test.ts"
  ]
}
